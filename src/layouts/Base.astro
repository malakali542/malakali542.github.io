---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import frauncesRoman from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header, { type Crumb, type TocItem } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBar from '../components/StatusBar.astro';
import Ask from '../components/Ask.astro';
import Cursor from '../components/Cursor.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  crumb?: Crumb;
  toc?: TocItem[];
}

const { title, description = site.description, image = '/og.png', type = 'website', published, crumb, toc } = Astro.props;
const fullTitle = (title ? `${title} · ${site.title}` : `${site.title} · research product manager`).toLowerCase();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="expect" href="#topbar" blocking="render" />
    <link rel="preload" href={frauncesRoman} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="theme-color" content="#f1f1ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <Header crumb={crumb} toc={toc} />
    <div class="page">
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <StatusBar />
    <Ask />
    <Cursor />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      // Local time in Seattle for the status bar.
      const clock = document.querySelector<HTMLElement>('[data-clock]');
      if (clock) {
        const format = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', hour: 'numeric', minute: '2-digit' });
        const tick = () => (clock.textContent = format.format(new Date()).toLowerCase());
        tick();
        window.setInterval(tick, 20000);
      }

      // Table of contents: mark the section currently at the top of the screen. The rail dot follows
      // aria-current (see Header), so it only changes when the section does.
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
      const tocTargets = tocLinks.map((link) => document.getElementById(link.dataset.toc ?? '')).filter((el): el is HTMLElement => !!el);
      if (tocTargets.length) {
        let frame = 0;
        let hold = 0;
        let currentId = tocLinks.find((link) => link.hasAttribute('aria-current'))?.dataset.toc;
        const setCurrent = (id: string) => {
          if (id === currentId) return;
          currentId = id;
          tocLinks.forEach((link) => {
            if (link.dataset.toc === id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        };
        const mark = () => {
          frame = 0;
          if (hold) return;
          const line = window.innerHeight * 0.3;
          let current = tocTargets[0];
          for (const target of tocTargets) {
            if (target.getBoundingClientRect().top <= line) current = target;
            else break;
          }
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = tocTargets[tocTargets.length - 1];
          setCurrent(current.id);
        };
        // A click sends the dot straight to its item and holds it there until the page stops scrolling,
        // so it doesn't step through every section on the way.
        const holdWhileScrolling = () => {
          window.clearTimeout(hold);
          hold = window.setTimeout(() => (hold = 0), 160);
        };
        const release = () => {
          window.clearTimeout(hold);
          hold = 0;
        };
        tocLinks.forEach((link) =>
          link.addEventListener('click', (event) => {
            if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            setCurrent(link.dataset.toc ?? '');
            holdWhileScrolling();
          }),
        );
        // Scrolling by hand takes over from a click.
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((type) => window.addEventListener(type, release, { passive: true }));
        window.addEventListener('scroll', () => (hold ? holdWhileScrolling() : (frame ||= window.requestAnimationFrame(mark))), { passive: true });
        // When the address names a section, Header already started the dot there and the jump to it
        // fires a scroll, so measuring now (before that jump) would pull the dot away and back. Check
        // once more after load in case the browser restored a different spot without scrolling.
        let hashId = location.hash.slice(1);
        try {
          hashId = decodeURIComponent(hashId);
        } catch {}
        if (!tocLinks.some((link) => link.dataset.toc === hashId)) mark();
        else window.addEventListener('load', () => (frame ||= window.requestAnimationFrame(mark)), { once: true });
      }

      // Loop videos play only while on screen. Reduced-motion users get controls instead.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
      videos.forEach((video) => {
        const start = Number(video.dataset.start ?? 0);
        if (!start) return;
        const jump = () => {
          if (video.currentTime < start - 0.25) video.currentTime = start;
        };
        video.addEventListener('loadedmetadata', jump);
        video.addEventListener('timeupdate', jump);
        if (video.readyState >= 1) jump();
      });
      if (reduceMotion) {
        videos.forEach((v) => (v.controls = true));
      } else {
        const videoObserver = new IntersectionObserver(
          (entries) => {
            for (const { target, isIntersecting } of entries) {
              const video = target as HTMLVideoElement;
              if (isIntersecting) video.play().catch(() => {});
              else video.pause();
            }
          },
          { threshold: 0.25 },
        );
        videos.forEach((v) => videoObserver.observe(v));
      }

      // YouTube embeds load only after a click.
      document.querySelectorAll<HTMLButtonElement>('button[data-yt]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const id = button.dataset.yt;
          const start = button.dataset.start ? `&start=${button.dataset.start}` : '';
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1${start}`;
          iframe.title = button.dataset.title ?? 'video';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          iframe.className = 'yt-frame';
          const wrapper = document.createElement('div');
          wrapper.className = 'yt media-interactive';
          wrapper.append(iframe);
          button.replaceWith(wrapper);
        });
      });

      // Sequenced illustrations: reveal [data-step] children on a timeline, loop while visible.
      document.querySelectorAll<HTMLElement>('[data-seq]').forEach((root) => {
        const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
        if (reduceMotion) {
          steps.forEach((s) => s.classList.add('is-on'));
          return;
        }
        const cycle = Number(root.dataset.cycle ?? 12000);
        const svgs = Array.from(root.querySelectorAll<SVGSVGElement>('svg'));
        let timers: number[] = [];
        let loop: number | undefined;
        const run = () => {
          timers.forEach(clearTimeout);
          root.classList.add('seq-on');
          steps.forEach((s) => s.classList.remove('is-on'));
          timers = steps.map((s) => window.setTimeout(() => s.classList.add('is-on'), Number(s.dataset.at ?? 0)));
        };
        const start = () => {
          if (loop) return;
          svgs.forEach((svg) => svg.unpauseAnimations());
          run();
          loop = window.setInterval(run, cycle);
        };
        const stop = () => {
          window.clearInterval(loop);
          loop = undefined;
          svgs.forEach((svg) => svg.pauseAnimations());
          timers.forEach(clearTimeout);
          root.classList.remove('seq-on');
          steps.forEach((s) => s.classList.add('is-on'));
        };
        new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), { threshold: 0.3 }).observe(root);
      });
    </script>
    <style is:global>
      [data-seq] [data-step] {
        transition: opacity 0.45s ease, transform 0.45s ease;
      }

      [data-seq].seq-on [data-step]:not(.is-on) {
        opacity: 0;
        transform: translateY(0.4em);
      }
    </style>
  </body>
</html>
