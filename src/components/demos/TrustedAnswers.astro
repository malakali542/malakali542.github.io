---
// Illustration in the style of Microsoft 365 Copilot Chat (work account, light theme, Fluent 2 tokens).
// Not the shipped UI and not real eval data. Steps run on the data-seq timeline in Base.astro.
---

<div
  class="demo demo-trust"
  data-seq
  data-cycle="16000"
  role="img"
  aria-label="Illustration of Microsoft 365 Copilot Chat in light mode. An IT admin asks how to block personal accounts on company laptops. Copilot searches Microsoft Learn and the organization's IT guidance, then answers with numbered citations: set a device policy that covers every managed laptop and pilot it on one group first. A release check panel then shows an LLM judge, calibrated to expert graders, scoring that grounded answer and a web search plus generic model answer, which suggests a registry edit from a 2019 forum thread, on tool invocation and response quality against a threshold. The grounded answer passes the release gate, the web answer is blocked, and the panel ends with +7 pts session success."
>
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="m365ta-ga" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2fc4f2" />
        <stop offset="0.55" stop-color="#3d6cf4" />
        <stop offset="1" stop-color="#7a5cf3" />
      </linearGradient>
      <linearGradient id="m365ta-gb" x1="1" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#ffb84a" />
        <stop offset="0.5" stop-color="#f6609e" />
        <stop offset="1" stop-color="#b45cf2" />
      </linearGradient>
      <symbol id="m365ta-mark" viewBox="0 0 24 24">
        <path fill="url(#m365ta-ga)" d="M8.3 3h5.2c1.1 0 1.9 1 1.6 2.1l-3.4 13.2A3.6 3.6 0 0 1 8.2 21H4.4c-1.1 0-1.9-1-1.6-2.1L5.9 5A2.6 2.6 0 0 1 8.3 3z" />
        <path fill="url(#m365ta-gb)" fill-opacity="0.92" d="M15.7 21h-5.2c-1.1 0-1.9-1-1.6-2.1l3.4-13.2A3.6 3.6 0 0 1 15.8 3h3.8c1.1 0 1.9 1 1.6 2.1L18.1 19a2.6 2.6 0 0 1-2.4 2z" />
      </symbol>
      <symbol id="m365ta-compose" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.5 3.5h-4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-4" />
          <path d="M14.4 3.3a1.5 1.5 0 0 1 2.2 2.1L10.4 11.7l-2.9.8.8-2.9z" />
        </g>
      </symbol>
      <symbol id="m365ta-shield" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 2.5 4 4.7v4.6c0 3.6 2.5 6.3 6 8.2 3.5-1.9 6-4.6 6-8.2V4.7z" />
          <path d="m7.2 9.9 2 2 3.7-3.9" />
        </g>
      </symbol>
      <symbol id="m365ta-plus" viewBox="0 0 20 20">
        <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M10 4v12M4 10h12" />
      </symbol>
      <symbol id="m365ta-send" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M3.6 3.7 17 10 3.6 16.3 5.7 10z" />
          <path d="M5.7 10h5" />
        </g>
      </symbol>
      <symbol id="m365ta-check" viewBox="0 0 20 20">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m4.5 10.4 3.6 3.6 7.4-8" />
      </symbol>
      <symbol id="m365ta-dismiss" viewBox="0 0 20 20">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="m5.5 5.5 9 9m0-9-9 9" />
      </symbol>
      <symbol id="m365ta-block" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="10" cy="10" r="6.5" />
          <path d="m5.5 5.5 9 9" />
        </g>
      </symbol>
      <symbol id="m365ta-copy" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <rect x="7" y="7" width="9.5" height="9.5" rx="2" />
          <path d="M13 7V5.5a2 2 0 0 0-2-2H5.5a2 2 0 0 0-2 2V11a2 2 0 0 0 2 2H7" />
        </g>
      </symbol>
      <symbol id="m365ta-like" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M6.5 8.8 9.3 3.5c1 0 1.9.9 1.7 2l-.5 2.6h4.2a1.7 1.7 0 0 1 1.7 2.1l-1.2 5a1.8 1.8 0 0 1-1.7 1.3H6.5z" />
          <path d="M3.5 8.8h3v7.7h-3z" />
        </g>
      </symbol>
      <symbol id="m365ta-dislike" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" transform="rotate(180 10 10)">
          <path d="M6.5 8.8 9.3 3.5c1 0 1.9.9 1.7 2l-.5 2.6h4.2a1.7 1.7 0 0 1 1.7 2.1l-1.2 5a1.8 1.8 0 0 1-1.7 1.3H6.5z" />
          <path d="M3.5 8.8h3v7.7h-3z" />
        </g>
      </symbol>
      <symbol id="m365ta-book" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M4 15.5V4.8A1.8 1.8 0 0 1 5.8 3H16v11H5.8A1.8 1.8 0 0 0 4 15.8 1.8 1.8 0 0 0 5.8 17.5H16" />
          <path d="M7.5 6.5h5" />
        </g>
      </symbol>
      <symbol id="m365ta-doc" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M5.5 2.5h6l4 4v10a1.5 1.5 0 0 1-1.5 1.5H5.5A1.5 1.5 0 0 1 4 16.5V4a1.5 1.5 0 0 1 1.5-1.5z" />
          <path d="M11.5 2.5v4h4M7 11h6M7 14h4" />
        </g>
      </symbol>
      <symbol id="m365ta-forum" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M3 5.5a2 2 0 0 1 2-2h6.5a2 2 0 0 1 2 2V9a2 2 0 0 1-2 2H8l-3 2.5V11a2 2 0 0 1-2-2z" />
          <path d="M16 8.5a1.5 1.5 0 0 1 1.5 1.5v3.5A1.5 1.5 0 0 1 16 15v2l-2.5-2h-3A1.5 1.5 0 0 1 9 13.5" />
        </g>
      </symbol>
      <symbol id="m365ta-globe" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="10" cy="10" r="7" />
          <path d="M3 10h14M10 3c1.9 2 2.8 4.4 2.8 7s-.9 5-2.8 7c-1.9-2-2.8-4.4-2.8-7S8.1 5 10 3z" />
        </g>
      </symbol>
      <symbol id="m365ta-gate" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <rect x="4" y="3.5" width="12" height="14" rx="2" />
          <path d="M7.5 3.5v-1h5v1M7.2 10.6l1.9 1.9 3.7-3.8" />
        </g>
      </symbol>
      <symbol id="m365ta-trend" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
          <path d="m3 14 4.5-4.5 3 3L17 6" />
          <path d="M12.5 6H17v4.5" />
        </g>
      </symbol>
      <symbol id="m365ta-chat" viewBox="0 0 20 20">
        <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" d="M10 3c3.9 0 7 2.8 7 6.3s-3.1 6.2-7 6.2c-.9 0-1.8-.1-2.6-.4L4 16.5l.9-3.1A6 6 0 0 1 3 9.3C3 5.8 6.1 3 10 3z" />
      </symbol>
      <symbol id="m365ta-search" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="8.5" cy="8.5" r="5" />
          <path d="m12.3 12.3 4.2 4.2" />
        </g>
      </symbol>
      <symbol id="m365ta-apps" viewBox="0 0 20 20">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <rect x="3.5" y="3.5" width="5" height="5" rx="1.2" />
          <rect x="11.5" y="3.5" width="5" height="5" rx="1.2" />
          <rect x="3.5" y="11.5" width="5" height="5" rx="1.2" />
          <rect x="11.5" y="11.5" width="5" height="5" rx="1.2" />
        </g>
      </symbol>
    </defs>
  </svg>

  <div class="m-rail">
    <svg class="mark"><use href="#m365ta-mark"></use></svg>
    <span class="r-i sel"><svg class="i"><use href="#m365ta-chat"></use></svg></span>
    <span class="r-i"><svg class="i"><use href="#m365ta-search"></use></svg></span>
    <span class="r-i"><svg class="i"><use href="#m365ta-apps"></use></svg></span>
    <span class="me"></span>
  </div>

  <div class="bar">
    <span class="m-brand"><svg class="mark"><use href="#m365ta-mark"></use></svg>M365 Copilot</span>
    <span class="mode"><span class="on">Work</span><span>Web</span></span>
    <span class="tools">
      <span class="tool new"><svg class="i"><use href="#m365ta-compose"></use></svg></span>
      <span class="tool edp"><svg class="i"><use href="#m365ta-shield"></use></svg></span>
    </span>
  </div>

  <div class="stage">
    <div class="chat">
      <div class="convo">
        <div class="greet"><svg class="mark"><use href="#m365ta-mark"></use></svg><span>What can I help you with?</span></div>
        <div class="user" data-step data-at="2600">How do I block personal accounts on our company laptops?</div>
        <div class="acts">
          <div class="act" data-step data-at="3050">
            <span class="st"><span class="spin"></span><svg class="i ok" data-step data-at="3950"><use href="#m365ta-check"></use></svg></span>
            <span class="act-t">Searching <b>Microsoft Learn</b></span>
          </div>
          <div class="act" data-step data-at="3450">
            <span class="st"><span class="spin"></span><svg class="i ok" data-step data-at="4350"><use href="#m365ta-check"></use></svg></span>
            <span class="act-t">Searching <b>your org’s IT guidance</b></span>
          </div>
        </div>
        <div class="reply" data-step data-at="4550">
          <p class="ans"><span class="c" data-step data-at="4600">Set it as a </span><strong class="c" data-step data-at="4760">device policy</strong><span class="c" data-step data-at="4920"> so it covers every </span><span class="c" data-step data-at="5080">managed laptop.</span><span class="cite" data-step data-at="5280">1</span><span class="c" data-step data-at="5480"> Pilot it on one </span><span class="c" data-step data-at="5640">group first.</span><span class="cite" data-step data-at="5840">2</span></p>
          <div class="grow" data-step data-at="6150">
            <div class="refs">
              <span class="ref" data-step data-at="6200">
                <span class="n">1</span><svg class="g learn"><use href="#m365ta-book"></use></svg>
                <span class="t"><b>Microsoft Learn</b><small>learn.microsoft.com</small></span>
              </span>
              <span class="ref" data-step data-at="6350">
                <span class="n">2</span><svg class="g org"><use href="#m365ta-doc"></use></svg>
                <span class="t"><b>Your IT guidance</b><small>Laptop rollout guide</small></span>
              </span>
            </div>
          </div>
          <div class="grow" data-step data-at="6650">
            <div class="foot">
              <svg class="i"><use href="#m365ta-copy"></use></svg>
              <svg class="i"><use href="#m365ta-like"></use></svg>
              <svg class="i"><use href="#m365ta-dislike"></use></svg>
            </div>
          </div>
        </div>
        <span class="follow" data-step data-at="7050">How do I pick a pilot group?</span>
      </div>

      <div class="prompt">
        <svg class="i plus"><use href="#m365ta-plus"></use></svg>
        <span class="field">
          <span class="ph">Message Copilot</span>
          <span class="typed" data-step data-at="900"><span class="tl" dir="ltr"><span class="w" data-step data-at="960">How </span><span class="w" data-step data-at="1080">do </span><span class="w" data-step data-at="1180">I </span><span class="w" data-step data-at="1300">block </span><span class="w" data-step data-at="1440">personal </span><span class="w" data-step data-at="1600">accounts </span><span class="w" data-step data-at="1740">on </span><span class="w" data-step data-at="1840">our </span><span class="w" data-step data-at="1960">company </span><span class="w" data-step data-at="2120">laptops?</span><span class="caret"></span></span></span>
        </span>
        <span class="send"><svg class="i"><use href="#m365ta-send"></use></svg></span>
        <span class="k-send" data-step data-at="2380"></span>
      </div>
      <span class="disc">AI-generated content may be incorrect</span>
    </div>

    <span class="scrim" data-step data-at="7700"></span>

    <div class="panel" data-step data-at="7700">
      <div class="p-head">
        <svg class="i p-icon"><use href="#m365ta-gate"></use></svg>
        <span class="p-title">Release check</span>
        <span class="legend"><i></i>Threshold</span>
        <span class="p-sub">LLM judge, calibrated to expert graders</span>
      </div>

      <div class="row good" data-step data-at="8150">
        <div class="rh">
          <span class="who"><svg class="mark"><use href="#m365ta-mark"></use></svg>Copilot, grounded</span>
          <span class="badge pass" data-step data-at="11100"><svg class="i"><use href="#m365ta-check"></use></svg>Passes gate</span>
        </div>
        <div class="rs">
          <span class="src"><svg class="g learn"><use href="#m365ta-book"></use></svg>Microsoft Learn</span>
          <span class="src"><svg class="g org"><use href="#m365ta-doc"></use></svg>IT guidance</span>
        </div>
        <div class="meters">
          <span class="ml">Tool invocation</span>
          <span class="track"><span class="fill" style="width: 91%" data-step data-at="9150"></span><span class="tick"></span></span>
          <svg class="i mk" data-step data-at="10450"><use href="#m365ta-check"></use></svg>
          <span class="ml">Response quality</span>
          <span class="track"><span class="fill" style="width: 87%" data-step data-at="9300"></span><span class="tick"></span></span>
          <svg class="i mk" data-step data-at="10600"><use href="#m365ta-check"></use></svg>
        </div>
      </div>

      <div class="row bad" data-step data-at="8550">
        <div class="rh">
          <span class="who"><svg class="i globe"><use href="#m365ta-globe"></use></svg>Web search + generic model</span>
          <span class="badge block" data-step data-at="11400"><svg class="i"><use href="#m365ta-block"></use></svg>Blocked</span>
        </div>
        <div class="rs">
          <span class="snip">“Edit the registry on each laptop.”</span>
          <span class="src old"><svg class="g"><use href="#m365ta-forum"></use></svg>Forum thread, 2019</span>
        </div>
        <div class="meters">
          <span class="ml">Tool invocation</span>
          <span class="track"><span class="fill" style="width: 46%" data-step data-at="9550"></span><span class="tick"></span></span>
          <svg class="i mk" data-step data-at="10750"><use href="#m365ta-dismiss"></use></svg>
          <span class="ml">Response quality</span>
          <span class="track"><span class="fill" style="width: 31%" data-step data-at="9700"></span><span class="tick"></span></span>
          <svg class="i mk" data-step data-at="10900"><use href="#m365ta-dismiss"></use></svg>
        </div>
      </div>

      <div class="gain" data-step data-at="11900"><svg class="i"><use href="#m365ta-trend"></use></svg><b>+7 pts</b> session success</div>
    </div>
  </div>

  <span class="outro" data-step data-at="15500" aria-hidden="true"></span>
  <span class="illustration-tag">illustration</span>
</div>

<style>
  /* Fixed product palette so the illustration reads the same in the site's light and dark themes.
     Neutrals, status colors, radii, shadows and motion curves follow Fluent 2 web tokens. The indigo
     accent is the one Microsoft 365 Copilot Chat uses for its compose button and selected states. */
  .demo-trust {
    --m-bg: #fafafa;
    --m-fg1: #242424;
    --m-fg2: #424242;
    --m-fg3: #616161;
    --m-line: #e0e0e0;
    --m-line-soft: #f0f0f0;
    --m-brand: #464feb;
    --m-brand-ink: #3a41cc;
    --m-brand-tint: #e8eafd;
    --m-ok: #107c10;
    --m-ok-ink: #0e700e;
    --m-ok-bg: #f1faf1;
    --m-ok-line: #9fd89f;
    --m-no: #c50f1f;
    --m-no-ink: #b10e1c;
    --m-no-bg: #fdf3f4;
    --m-no-line: #eeacb2;
    --m-decel: cubic-bezier(0.1, 0.9, 0.2, 1);
    --m-easy: cubic-bezier(0.33, 0, 0.67, 1);
    --m-rail: 0px;

    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: 'Segoe UI Variable Text', 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', sans-serif;
    font-size: clamp(10px, 2.3cqmin, 15px);
    line-height: 1.4;
    color: var(--m-fg1);
    background: var(--m-bg);
    -webkit-font-smoothing: antialiased;
    font-variation-settings: normal;
  }

  .defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .i,
  .g,
  .mark {
    display: block;
    flex: none;
    width: 1.15em;
    height: 1.15em;
  }

  /* ---------- window chrome ---------- */
  .m-rail {
    display: none;
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--m-rail);
    flex-direction: column;
    align-items: center;
    gap: 1.05em;
    padding-top: 0.85em;
    background: #f5f5f5;
    border-right: 1px solid #ebebeb;
  }

  .m-rail .mark {
    width: 1.55em;
    height: 1.55em;
    margin-bottom: 0.35em;
  }

  .r-i {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 0.45em;
    color: var(--m-fg3);
  }

  .r-i .i {
    width: 1.3em;
    height: 1.3em;
  }

  .r-i.sel {
    background: #fff;
    color: var(--m-brand);
    box-shadow: 0 0 2px rgb(0 0 0 / 0.1), 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .r-i.sel::before {
    content: '';
    position: absolute;
    left: -0.6em;
    top: 0.55em;
    bottom: 0.55em;
    width: 3px;
    border-radius: 2px;
    background: var(--m-brand);
  }

  .me {
    margin-top: auto;
    margin-bottom: 1em;
    width: 1.8em;
    height: 1.8em;
    border-radius: 50%;
    background: linear-gradient(135deg, #c8d9f4, #a9bfe8);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .bar {
    position: absolute;
    top: 0;
    left: var(--m-rail);
    right: 0;
    height: 3em;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 0.85em;
  }

  .m-brand {
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 600;
  }

  .m-brand .mark {
    width: 1.4em;
    height: 1.4em;
  }

  .mode {
    display: inline-flex;
    padding: 0.16em;
    border-radius: 999px;
    background: #e6e6e6;
    font-size: max(9px, 0.88em);
    color: var(--m-fg3);
  }

  .mode span {
    padding: 0.18em 0.9em;
    border-radius: 999px;
  }

  .mode .on {
    background: #fff;
    color: var(--m-brand-ink);
    font-weight: 600;
    box-shadow: 0 0 2px rgb(0 0 0 / 0.12), 0 1px 2px rgb(0 0 0 / 0.14);
  }

  .tools {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.55em;
  }

  .tool {
    display: grid;
    place-items: center;
    width: 1.95em;
    height: 1.95em;
    border-radius: 0.4em;
  }

  .tool .i {
    width: 1.2em;
    height: 1.2em;
  }

  .tool.new {
    background: var(--m-brand);
    color: #fff;
  }

  .tool.edp {
    color: var(--m-ok);
  }

  /* ---------- chat ---------- */
  .stage {
    position: absolute;
    top: 3em;
    left: var(--m-rail);
    right: 0;
    bottom: 0;
  }

  .chat {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 0.15em 0.85em 36px;
    transition: transform 0.8s var(--m-decel);
  }

  .convo {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
    padding-top: 0.2em;
    transition: opacity 0.4s var(--m-easy) 0.55s;
  }

  .greet {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    font-size: 1.3em;
    font-weight: 600;
    text-align: center;
    opacity: 0;
    transition: opacity 0.35s var(--m-easy);
  }

  .greet .mark {
    width: 1.9em;
    height: 1.9em;
  }

  .user {
    align-self: flex-end;
    max-width: 84%;
    padding: 0.5em 0.8em;
