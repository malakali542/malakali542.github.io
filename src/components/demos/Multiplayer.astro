---
// Illustration of the multiplayer, self-improving system, drawn like a live collaboration canvas: a dot grid,
// shared session cards, presence colors and named cursors. Ben opens Ana's session and drags a piece of it into
// his own, Cleo changes the system's code, the system learns from that change and every session gets better.
// One team's project now runs across 5+ teams and 300+ people. The teammates' names are made up.
// Layouts: wide for 16:9 frames, square for big square tiles, and square-sm for small or short frames.
const people = {
  a: { name: 'ana', color: '#f26b1d' },
  b: { name: 'ben', color: '#2563eb' },
  c: { name: 'cleo', color: '#08875d' },
  d: { name: 'dina', color: '#7c3aed' },
} as const;
type Id = keyof typeof people;
type P = [number, number];
const ids: Id[] = ['a', 'b', 'c', 'd'];

// Label widths in em, measured in the browser (Inter Variable 600, the chip in IBM Plex Mono 500), so every
// pill fits its text.
const EM = { benSays: 13.33, cleoSays: 10.91, ben: 1.83, cleo: 2.04, learns: 8.59, chip: 8.4, footLong: 24.64, footShort: 16.06 };

// Ben's and Cleo's cursor moves run on their own clocks. The other steps are timed against them.
const BEN = { at: 300, dur: 3600 };
const CLEO = { at: 4100, dur: 3000 };
const T = {
  view: BEN.at + 0.25 * BEN.dur,
  build: BEN.at + 0.28 * BEN.dur,
  drop: BEN.at + 0.58 * BEN.dur,
  benSays: BEN.at + 0.88 * BEN.dur,
  chip: CLEO.at + 0.2 * CLEO.dur,
  cleoSays: CLEO.at + 0.64 * CLEO.dur,
  learn: 6950,
  spread: 7650,
  checks: 8500,
  foot: 9200,
};

const round = (n: number) => Math.round(n * 100) / 100;

const layouts = [
  {
    name: 'wide', w: 800, h: 450, cw: 236, ch: 118, u: 1,
    cards: { a: [34, 32], b: [530, 32], c: [34, 288], d: [530, 288] } as Record<Id, P>,
    sys: { x: 302, y: 154, w: 196, h: 126, title: 21, inside: false },
    details: true, chip: 13, flag: 14, cursor: 1,
    ben: { start: [690, 128], click: [196, 100], rest: [292, 86], flag: [12, 17] as P },
    cleo: { start: [250, 400], type: [196, 366], rest: [196, 366], flag: [12, 17] as P },
    learn: { x: 400, y: 307, size: 14 },
    foot: { x: 400, y: 438, size: 15, middle: true, short: false },
  },
  {
    name: 'square', w: 600, h: 600, cw: 236, ch: 120, u: 1.08,
    cards: { a: [24, 92], b: [340, 92], c: [24, 396], d: [340, 396] } as Record<Id, P>,
    sys: { x: 192, y: 254, w: 216, h: 120, title: 22, inside: false },
    details: true, chip: 15, flag: 16, cursor: 1.15,
    ben: { start: [470, 190], click: [190, 168], rest: [150, 20], flag: [14, 19] as P },
    cleo: { start: [250, 506], type: [128, 478], rest: [128, 478], flag: [14, 19] as P },
    learn: { x: 300, y: 233, size: 15 },
    foot: { x: 24, y: 572, size: 15, middle: false, short: false },
  },
  {
    name: 'square-sm', w: 600, h: 600, cw: 240, ch: 124, u: 1.45,
    cards: { a: [20, 96], b: [340, 96], c: [20, 404], d: [340, 404] } as Record<Id, P>,
    sys: { x: 176, y: 250, w: 248, h: 104, title: 28, inside: true },
    details: false, chip: 21, flag: 22, cursor: 1.5,
    ben: { start: [480, 196], click: [200, 176], rest: [40, 18], flag: [16, 22] as P },
    cleo: { start: [250, 516], type: [248, 468], rest: [24, 340], flag: [16, 22] as P },
    learn: { x: 300, y: 0, size: 21 },
    foot: { x: 20, y: 574, size: 22, middle: false, short: true },
  },
].map((l) => {
  const { u } = l;
  const cx = l.sys.x + l.sys.w / 2;
  const cy = l.sys.y + l.sys.h / 2;
  const cards = ids.map((id) => {
    const [x, y] = l.cards[id];
    const right = x < cx;
    const top = y < cy;
    return {
      id, x, y, ...people[id],
      // The card corner that faces the system, where its connector starts.
      hx: right ? x + l.cw : x,
      hy: top ? y + l.ch : y,
      ax: round(x + 22 * u),
      ay: round(y + 0.25 * l.ch),
    };
  });
  const [a, b, c] = cards;
  const flag = (em: number, [dx, dy]: P) => ({
    x: dx, y: dy, w: round(em * l.flag + 1.3 * l.flag), h: round(1.8 * l.flag),
    tx: round(dx + 0.65 * l.flag), ty: round(dy + 0.9 * l.flag + 0.36 * l.flag),
  });
  const chipBox = { x: round(c.x + 14 * u), y: round(c.y + 0.44 * l.ch), w: round(EM.chip * l.chip + 1.3 * l.chip), h: round(1.8 * l.chip) };
  const learnW = round(EM.learns * l.learn.size + 3.1 * l.learn.size);
  const footText = l.foot.short ? EM.footShort : EM.footLong;
  const pileR = round(0.6 * l.foot.size);
  const pileW = l.foot.short ? 0 : round(2 * pileR + 4 * 0.95 * l.foot.size + 0.7 * l.foot.size);
  const footW = pileW + footText * l.foot.size;
  const footX = l.foot.middle ? round(l.foot.x - footW / 2) : l.foot.x;
  const ripple = (p: P) => ({ x: p[0], y: p[1] });
  // A piece of Ana's session: in Ben's card after the drop, and as the ghost he drags. He lets go with the
  // cursor near its right end, so the ghost lands exactly where the piece appears.
  const piece = { x: round(b.x + 14 * u), y: round(b.y + 0.6 * l.ch), w: round(0.66 * l.cw), h: round(0.28 * l.ch) };
  const drop: P = [round(piece.x + piece.w - 12 * u), round(piece.y + piece.h / 2)];
  const benPath: P[] = [l.ben.start as P, l.ben.click as P, drop, l.ben.rest as P];
  return {
    ...l, cx, cy, cards,
    vars: (pts: P[]) => pts.map(([x, y], i) => `--x${i}: ${x}px; --y${i}: ${y}px`).join('; '),
    benShort: flag(EM.ben, l.ben.flag),
    benLong: flag(EM.benSays, l.ben.flag),
    cleoShort: flag(EM.cleo, l.cleo.flag),
    cleoLong: flag(EM.cleoSays, l.cleo.flag),
    arrow: { x1: round(a.x + l.cw + 8 * u), x2: round(b.x - 8 * u), y: round(a.y + 0.3 * l.ch) },
    select: { x: a.x - 5, y: a.y - 5, w: l.cw + 10, h: l.ch + 10 },
    clickAt: ripple(l.ben.click as P),
    dropAt: ripple(drop),
    piece, drop, benPath,
    chipBox,
    diff: { x: chipBox.x + chipBox.w, y: chipBox.y + chipBox.h / 2 },
    learnBox: { x: round(l.learn.x - learnW / 2), y: round(l.learn.y - 0.95 * l.learn.size), w: learnW, h: round(1.9 * l.learn.size) },
    footX, pileR, pileW,
  };
});

// The cursor arrow, tip at 0,0.
const pointer = 'M0 0 L0 17 L4.2 13.1 L7.3 20 L10.2 18.7 L7.2 11.9 L13 11.9 Z';
// A circular arrow for "learns", radius 1, drawn clockwise from 1 o'clock around to 11 o'clock.
const loopIcon = (x: number, y: number, r: number) => {
  const p = (deg: number) => [round(x + r * Math.sin((deg * Math.PI) / 180)), round(y - r * Math.cos((deg * Math.PI) / 180))];
  const [sx, sy] = p(40);
  const [ex, ey] = p(330);
  const t = (330 * Math.PI) / 180;
  const [tx, ty] = [Math.cos(t), Math.sin(t)];
  const s = r * 0.62;
  return {
    arc: `M ${sx} ${sy} A ${r} ${r} 0 1 1 ${ex} ${ey}`,
    head: `M ${round(ex + tx * s)} ${round(ey + ty * s)} L ${round(ex - ty * s * 0.8)} ${round(ey + tx * s * 0.8)} L ${round(ex + ty * s * 0.8)} ${round(ey - tx * s * 0.8)} Z`,
  };
};
const pile = [people.a.color, people.b.color, people.c.color, people.d.color];
---

<div
  class="demo demo-mp"
  data-seq
  data-cycle="14000"
  role="img"
  aria-label="Illustration of a multiplayer, self-improving AI system, drawn as a shared canvas. Four teammates' sessions sit around the system with live cursors. Ben opens Ana's session and builds on it in his own, Cleo changes the system's code, the system learns from it, and every session gets the update. One team's project now runs across 5+ teams and 300+ people."
>
  {layouts.map((l) => (
    <svg class={`mp-svg ${l.name}`} viewBox={`0 0 ${l.w} ${l.h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs>
        <linearGradient id={`mp-team-${l.name}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={people.a.color} />
          <stop offset="0.36" stop-color={people.b.color} />
          <stop offset="0.68" stop-color={people.c.color} />
          <stop offset="1" stop-color={people.d.color} />
        </linearGradient>
        <filter id={`mp-lift-${l.name}`} x="-12%" y="-12%" width="124%" height="140%">
          <feDropShadow dx="0" dy={2 * l.u} stdDeviation={5 * l.u} flood-color="#1f1b3d" flood-opacity="0.12" />
        </filter>
        <filter id={`mp-glow-${l.name}`} x="-30%" y="-40%" width="160%" height="180%">
          <feGaussianBlur stdDeviation={9 * l.u} />
        </filter>
      </defs>

      {l.cards.map((c) => <line class="link" x1={c.hx} y1={c.hy} x2={l.cx} y2={l.cy} />)}

      {l.cards.map((c) => (
        <g class={`card card-${c.id}`}>
          <rect class="card-box" x={c.x} y={c.y} width={l.cw} height={l.ch} rx={12 * l.u} filter={`url(#mp-lift-${l.name})`} />
          <circle cx={c.ax} cy={c.ay} r={12.5 * l.u} fill={c.color} />
          <text class="initial" x={c.ax} y={c.ay + 4.6 * l.u} font-size={13 * l.u} text-anchor="middle">{c.name[0]}</text>
          {l.details && <text class="card-title" x={c.ax + 20 * l.u} y={c.ay + 5 * l.u} font-size={14 * l.u}>{c.name}'s session</text>}
          {c.id !== 'c' && (
            <g>
              <text class="prompt" x={c.x + 16 * l.u} y={c.y + 0.5 * l.ch + 5 * l.u} font-size={15 * l.u} fill={c.color}>›</text>
              <rect class="bar" x={c.x + 30 * l.u} y={c.y + 0.5 * l.ch - 4 * l.u} width={0.5 * l.cw} height={8 * l.u} rx={4 * l.u} />
            </g>
          )}
          <rect class="bar soft" x={c.x + 16 * l.u} y={c.y + 0.69 * l.ch - 3.5 * l.u} width={0.78 * l.cw - 16 * l.u} height={7 * l.u} rx={3.5 * l.u} />
          <rect class="bar soft" x={c.x + 16 * l.u} y={c.y + 0.84 * l.ch - 3.5 * l.u} width={0.5 * l.cw} height={7 * l.u} rx={3.5 * l.u} />
        </g>
      ))}

      <g class="code-chip">
        <rect class="chip-box" x={l.chipBox.x} y={l.chipBox.y} width={l.chipBox.w} height={l.chipBox.h} rx={6 * l.u} />
        <g data-step data-at={T.chip}>
          <text class="chip-text" x={l.chipBox.x + 0.65 * l.chip} y={l.chipBox.y + l.chipBox.h / 2 + 0.36 * l.chip} font-size={l.chip}>edits the code</text>
          <rect class="chip-cover" x={l.chipBox.x + 0.5 * l.chip} y={l.chipBox.y + 3 * l.u} width={l.chipBox.w - 0.9 * l.chip} height={l.chipBox.h - 6 * l.u} />
          <rect class="caret" x={l.chipBox.x + 0.6 * l.chip} y={l.chipBox.y + 0.3 * l.chip} width={1.6 * l.u} height={1.2 * l.chip} style={`--run: ${round(EM.chip * l.chip)}px`} />
        </g>
      </g>

      <g data-step data-at={T.drop}>
        <g class="piece">
          <rect class="piece-box" x={l.piece.x} y={l.piece.y} width={l.piece.w} height={l.piece.h} rx={7 * l.u} />
          <circle cx={l.piece.x + 13 * l.u} cy={l.piece.y + l.piece.h / 2} r={6.5 * l.u} fill={people.a.color} />
          <rect class="piece-bar" x={l.piece.x + 26 * l.u} y={l.piece.y + l.piece.h / 2 - 3.5 * l.u} width={l.piece.w * 0.6} height={7 * l.u} rx={3.5 * l.u} />
        </g>
      </g>
      <g data-step data-at={T.view}>
        <circle class="viewer" cx={l.cards[0].x + l.cw - 46 * l.u} cy={l.cards[0].ay} r={9.5 * l.u} fill={people.b.color} />
        <text class="initial" x={l.cards[0].x + l.cw - 46 * l.u} y={l.cards[0].ay + 3.6 * l.u} font-size={10.5 * l.u} text-anchor="middle">b</text>
      </g>

      <g class="diff" style={`--dx: ${round(l.cx - l.diff.x)}px; --dy: ${round(l.cy - l.diff.y)}px`}>
        <rect x={l.diff.x - 9 * l.u} y={l.diff.y - 9 * l.u} width={18 * l.u} height={18 * l.u} rx={5 * l.u} />
        <path d={`M ${l.diff.x - 4.5 * l.u} ${l.diff.y} h ${9 * l.u} M ${l.diff.x} ${l.diff.y - 4.5 * l.u} v ${9 * l.u}`} />
      </g>
      <g data-step data-at={T.spread}>
        {l.cards.map((c) => (
          <circle class="pulse" cx={l.cx} cy={l.cy} r={5.5 * l.u} style={`--dx: ${round(c.hx - l.cx)}px; --dy: ${round(c.hy - l.cy)}px`} />
        ))}
      </g>

      <g class="sys">
        <rect class="sys-glow" x={l.sys.x} y={l.sys.y} width={l.sys.w} height={l.sys.h} rx={16 * l.u} stroke={`url(#mp-team-${l.name})`} filter={`url(#mp-glow-${l.name})`} />
        <rect class="sys-box" x={l.sys.x} y={l.sys.y} width={l.sys.w} height={l.sys.h} rx={16 * l.u} stroke={`url(#mp-team-${l.name})`} />
        <text class="sys-title" x={l.cx} y={l.sys.y + (l.sys.inside ? 0.42 : 0.36) * l.sys.h} font-size={l.sys.title} text-anchor="middle">the system</text>
        {l.details && <text class="sys-sub" x={l.cx} y={l.sys.y + 0.36 * l.sys.h + 21 * l.u} font-size={13.5 * l.u} text-anchor="middle">shared by the team</text>}
        {l.details && (
          <g>
            <rect class="code" x={l.sys.x + 26 * l.u} y={l.sys.y + l.sys.h - 40 * l.u} width={l.sys.w * 0.34} height={5.5 * l.u} rx={2.75 * l.u} fill={people.d.color} />
            <rect class="code" x={l.sys.x + 26 * l.u + l.sys.w * 0.37} y={l.sys.y + l.sys.h - 40 * l.u} width={l.sys.w * 0.22} height={5.5 * l.u} rx={2.75 * l.u} fill={people.b.color} />
            <rect class="code" x={l.sys.x + 38 * l.u} y={l.sys.y + l.sys.h - 29 * l.u} width={l.sys.w * 0.46} height={5.5 * l.u} rx={2.75 * l.u} fill="#8c86c8" />
            <g data-step data-at={T.learn}>
              <rect class="code new" x={l.sys.x + 38 * l.u} y={l.sys.y + l.sys.h - 18 * l.u} width={l.sys.w * 0.3} height={5.5 * l.u} rx={2.75 * l.u} fill="#34d399" />
            </g>
          </g>
        )}
        {l.sys.inside && (
          <g class="learn-in" data-step data-at={T.learn}>
            <path class="loop" d={loopIcon(l.cx - EM.learns * l.learn.size / 2 - 0.2 * l.learn.size, l.sys.y + 0.72 * l.sys.h - 0.36 * l.learn.size, 0.42 * l.learn.size).arc} />
            <path class="loop-head" d={loopIcon(l.cx - EM.learns * l.learn.size / 2 - 0.2 * l.learn.size, l.sys.y + 0.72 * l.sys.h - 0.36 * l.learn.size, 0.42 * l.learn.size).head} />
            <text class="learn-text" x={l.cx + 0.45 * l.learn.size} y={l.sys.y + 0.72 * l.sys.h} font-size={l.learn.size} text-anchor="middle">the system learns</text>
          </g>
        )}
      </g>
      <g data-step data-at={T.learn}>
        <rect class="sys-pulse" x={l.sys.x} y={l.sys.y} width={l.sys.w} height={l.sys.h} rx={16 * l.u} />
      </g>
      {!l.sys.inside && (
        <g data-step data-at={T.learn}>
          <rect class="learn-box" x={l.learnBox.x} y={l.learnBox.y} width={l.learnBox.w} height={l.learnBox.h} rx={l.learnBox.h / 2} />
          <g class="spin" style={`transform-origin: ${round(l.learnBox.x + 1.25 * l.learn.size)}px ${l.learn.y}px`}>
            <path class="loop" d={loopIcon(l.learnBox.x + 1.25 * l.learn.size, l.learn.y, 0.42 * l.learn.size).arc} />
            <path class="loop-head" d={loopIcon(l.learnBox.x + 1.25 * l.learn.size, l.learn.y, 0.42 * l.learn.size).head} />
          </g>
          <text class="learn-text" x={l.learnBox.x + 2.1 * l.learn.size} y={l.learn.y + 0.36 * l.learn.size} font-size={l.learn.size}>the system learns</text>
        </g>
      )}

      {l.cards.map((c, i) => (
        <g data-step data-at={T.checks + i * 90}>
          <g class="check">
            <circle cx={c.x + l.cw - 20 * l.u} cy={c.ay} r={9.5 * l.u} />
            <path d={`M ${c.x + l.cw - 24.2 * l.u} ${c.ay + 0.2 * l.u} l ${3 * l.u} ${3 * l.u} l ${5.6 * l.u} ${-6 * l.u}`} />
          </g>
        </g>
      ))}

      <g data-step data-at={T.build}>
        <path class="build" d={`M ${l.arrow.x1} ${l.arrow.y} L ${l.arrow.x2 - 3 * l.u} ${l.arrow.y}`} pathLength="1" />
        <path class="build-head" d={`M ${l.arrow.x2 - 9 * l.u} ${l.arrow.y - 6 * l.u} L ${l.arrow.x2} ${l.arrow.y} L ${l.arrow.x2 - 9 * l.u} ${l.arrow.y + 6 * l.u} Z`} />
      </g>

      <rect class="select" x={l.select.x} y={l.select.y} width={l.select.w} height={l.select.h} rx={15 * l.u} />
      <circle class="ripple" cx={l.clickAt.x} cy={l.clickAt.y} r={12 * l.u} />
      <circle class="ripple ripple-drop" cx={l.dropAt.x} cy={l.dropAt.y} r={12 * l.u} />
      <g class="ghost" style={l.vars([l.ben.click as P, l.drop])}>
        <g transform={`translate(${l.piece.x - l.drop[0]} ${l.piece.y - l.drop[1]})`}>
          <rect class="piece-box" x="0" y="0" width={l.piece.w} height={l.piece.h} rx={7 * l.u} />
          <circle cx={13 * l.u} cy={l.piece.h / 2} r={6.5 * l.u} fill={people.a.color} />
          <rect class="piece-bar" x={26 * l.u} y={l.piece.h / 2 - 3.5 * l.u} width={l.piece.w * 0.6} height={7 * l.u} rx={3.5 * l.u} />
        </g>
      </g>

      <g class="cursor cursor-b" data-step data-at={BEN.at}>
        <g class="move" style={l.vars(l.benPath)}>
          <g class="flag-short">
            <rect x={l.benShort.x} y={l.benShort.y} width={l.benShort.w} height={l.benShort.h} rx={0.4 * l.flag} fill={people.b.color} />
            <text class="flag-text" x={l.benShort.tx} y={l.benShort.ty} font-size={l.flag}>ben</text>
          </g>
          <g class="flag-long" data-step data-at={T.benSays}>
            <rect x={l.benLong.x} y={l.benLong.y} width={l.benLong.w} height={l.benLong.h} rx={0.4 * l.flag} fill={people.b.color} />
            <text class="flag-text" x={l.benLong.tx} y={l.benLong.ty} font-size={l.flag}>ben builds on ana's session</text>
          </g>
          <g transform={`scale(${l.cursor})`}>
            <path class="pointer" d={pointer} fill={people.b.color} />
          </g>
        </g>
      </g>

      <g class="cursor cursor-c" data-step data-at={CLEO.at}>
        <g class="move" style={l.vars([l.cleo.start as P, l.cleo.type as P, l.cleo.rest as P])}>
          <g class="flag-short">
            <rect x={l.cleoShort.x} y={l.cleoShort.y} width={l.cleoShort.w} height={l.cleoShort.h} rx={0.4 * l.flag} fill={people.c.color} />
            <text class="flag-text" x={l.cleoShort.tx} y={l.cleoShort.ty} font-size={l.flag}>cleo</text>
          </g>
          <g class="flag-long" data-step data-at={T.cleoSays}>
            <rect x={l.cleoLong.x} y={l.cleoLong.y} width={l.cleoLong.w} height={l.cleoLong.h} rx={0.4 * l.flag} fill={people.c.color} />
            <text class="flag-text" x={l.cleoLong.tx} y={l.cleoLong.ty} font-size={l.flag}>cleo changes the code</text>
          </g>
          <g transform={`scale(${l.cursor})`}>
            <path class="pointer" d={pointer} fill={people.c.color} />
          </g>
        </g>
      </g>

      <g class="foot" data-step data-at={T.foot}>
        {!l.foot.short && pile.map((color, i) => (
          <circle class="face" cx={l.footX + l.pileR + i * 0.95 * l.foot.size} cy={l.foot.y - 0.36 * l.foot.size} r={l.pileR} fill={color} style={`--i: ${i}`} />
        ))}
        {!l.foot.short && (
          <circle class="face more" cx={l.footX + l.pileR + 4 * 0.95 * l.foot.size} cy={l.foot.y - 0.36 * l.foot.size} r={l.pileR} style="--i: 4" />
        )}
        <text class="foot-text" x={l.footX + l.pileW} y={l.foot.y} font-size={l.foot.size}>
          {l.foot.short ? '1 team → 5+ teams · 300+ people' : "one team's project, now 5+ teams and 300+ people"}
        </text>
      </g>
    </svg>
  ))}
