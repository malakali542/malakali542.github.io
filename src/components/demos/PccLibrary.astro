---
// Illustration in the style of PointClickCare's clinical web apps, not the real UI. Parts from the provider portal's
// shared UI library fly out of a component sheet and snap into the slots of a unit's resident list, then a CI pipeline
// runs before and after the speedup. Palette from PointClickCare's 2025 brand and web apps: kelp nav rail, sage
// selection, chiffon accents, outlined status badges, uppercase pill buttons.
// Every box sits on a fixed stage measured in em, one stage per frame shape, so a flight can start exactly on its
// sheet specimen and land exactly in its slot. The stage's em is sized from the container, like an SVG viewBox.

type Box = { x: number; y: number; w: number; h: number };
type Key = 'select' | 'button' | 'search' | 'badge' | 'row';

const T = {
  spec: { select: 150, button: 270, badge: 390, search: 510, row: 630 } as Record<Key, number>,
  fly: { select: 1200, button: 1700, search: 2200, row: 2700, badge: 3300 } as Record<Key, number>,
  clone: 4250,
  swap: 5500,
  before: 6000,
  beforeDone: 8400,
  marker: 8550,
  after: 8750,
  afterDone: 10430,
  gain: 10550,
  reset: 13350,
  cycle: 14000,
};

const residents = [
  { ini: 'RB', name: 'Rose B.', room: 'Rm 214', task: 'Progress note', status: 'due' },
  { ini: 'WK', name: 'Walt K.', room: 'Rm 216', task: 'Sign orders', status: 'done' },
  { ini: 'IM', name: 'Ida M.', room: 'Rm 221', task: 'Med review', status: 'due' },
  { ini: 'LP', name: 'Lou P.', room: 'Rm 223', task: 'Vitals check', status: 'done' },
];
const statusText = { due: 'Due today', done: 'Done' } as const;

// Relative stage durations. The after run is the same pipeline at 70% of the time.
const stages = [
  { name: 'install', f: 17 },
  { name: 'lint', f: 9 },
  { name: 'test', f: 31 },
  { name: 'build', f: 22 },
  { name: 'deploy', f: 21 },
];

const SEL_W = 8.6;
const BTN_W = 6.8;
const BADGE_W = 5.4;
const BADGE_H = 1.55;
const SEARCH_SW = 9;

type Spec = {
  query: string | null;
  W: number; H: number; m: number; gap: number; trayH: number; trayPad: number;
  bar: number; rail: number; pad: number; cardPad: number; hpad: number; vgap: number; tgap: number;
  ch: number; rowH: number; nRows: number; oneLine: boolean; title: boolean; thead: boolean; searchW: number;
  room: number; task: number; ks: number; kt: number; railLabels: boolean; captions: boolean;
  // Sheet: lines of specimens. With an inline head, the tray title shares the first line.
  lines: Key[][]; headInline: number; lineTop: number; lineGap: number; rowSw: number; specGap: number; tested: boolean;
  // CI rows. The pill sits in the gap the faster run leaves, or in the tray head when the gap is too narrow.
  ciTop: number; ciH: number; ciGap: number; ciLbl: number; ciPadR: number; pillInGap: boolean; afterLabels: boolean;
};

const base = {
  m: 1, gap: 0.8, trayPad: 1.1, bar: 2.3, rail: 3, pad: 0.7, cardPad: 0.9, hpad: 0.75, vgap: 0.7, tgap: 0.8,
  ch: 2.1, rowH: 2.3, oneLine: false, title: true, thead: true, searchW: 14.5, room: 4.6, task: 0, ks: 0.86, kt: 0.92,
  railLabels: false, captions: false, lines: [['select', 'button', 'badge'], ['search', 'row']] as Key[][], headInline: 0,
  lineTop: 2.45, lineGap: 0.65, rowSw: 17, specGap: 1, tested: true, ciTop: 2.15, ciH: 1.8, ciGap: 0.6, ciLbl: 3.6,
  ciPadR: 0.9, pillInGap: true, afterLabels: false,
};

// The 4:3 desktop tile is the default. The others switch in by container shape and size. Each keeps its smallest text
// at 9px or more over the sizes it covers, and keeps the bottom-right corner, where the illustration tag sits, clear.
const specs: Spec[] = [
  { ...base, query: null, W: 42, H: 31.5, trayH: 8.4, nRows: 3, rowH: 2.6 },
  {
    ...base, query: "(min-aspect-ratio: 29/20) and (min-width: 760px)", W: 64, H: 36, m: 1.4, gap: 1, trayH: 9.6,
    trayPad: 1.3, bar: 2.6, rail: 4.6, pad: 0.9, cardPad: 1.1, hpad: 0.95, tgap: 1, ch: 2.3, rowH: 2.95, nRows: 4,
    oneLine: true, searchW: 15, room: 6, task: 9, ks: 0.8, kt: 0.9, railLabels: true, captions: true,
    lines: [['select', 'button', 'search', 'badge', 'row']], lineTop: 2.5, specGap: 1.6,
    ciTop: 2.7, ciH: 2, ciGap: 0.9, ciLbl: 4.4, afterLabels: true,
  },
  {
    ...base, query: "(min-aspect-ratio: 29/20) and (max-width: 759.98px)", W: 48, H: 27, trayH: 8, rowH: 2.3, nRows: 3,
    oneLine: true, searchW: 11.4, room: 4.6, task: 7.4, ciH: 1.7, afterLabels: true,
  },
  {
    ...base, query: "(max-aspect-ratio: 29/20) and (min-aspect-ratio: 23/20) and (max-width: 439.98px)", W: 31, H: 23.25,
    m: 0.8, gap: 0.6, trayH: 7.6, trayPad: 0.85, bar: 2, rail: 2.4, pad: 0.6, cardPad: 0.7, hpad: 0.6, ch: 2, rowH: 2.2,
    nRows: 2, title: false, thead: false, searchW: 12.5, room: 0, ks: 0.9,
    lines: [['select', 'button', 'search'], ['row', 'badge']], lineTop: 2.25, lineGap: 0.6, rowSw: 14.4, specGap: 0.6,
    ciTop: 2.25, ciH: 1.6, ciGap: 0.55, ciLbl: 3.3, pillInGap: false,
  },
  {
    ...base, query: "(max-aspect-ratio: 29/20) and (min-aspect-ratio: 23/20) and (max-width: 319.98px)", W: 28.5, H: 21.4,
    m: 0.55, gap: 0.45, trayH: 7.5, trayPad: 0.75, bar: 1.9, rail: 2.2, pad: 0.5, cardPad: 0.6, hpad: 0.45, vgap: 0.45,
    tgap: 0.5, ch: 1.9, rowH: 2, nRows: 2, title: false, thead: false, searchW: 11, room: 0, ks: 0.93, kt: 0.94,
    lines: [['select', 'button'], ['search', 'badge'], ['row']], headInline: 6.4, lineTop: 0.45, lineGap: 0.45,
    rowSw: 13.4, specGap: 0.5, tested: false, ciTop: 2.8, ciH: 1.45, ciGap: 0.45, ciLbl: 3.2, ciPadR: 3.2, pillInGap: false,
  },
  {
    ...base, query: "(max-aspect-ratio: 23/20)", W: 27.6, H: 27.6, m: 0.7, gap: 0.55, trayH: 7.7, trayPad: 0.8, bar: 2,
    rail: 2.4, pad: 0.55, cardPad: 0.65, hpad: 0.55, ch: 2, rowH: 2.2, nRows: 3, title: false, searchW: 12, room: 4.2,
    ks: 0.9, lines: [['select', 'button'], ['search', 'badge'], ['row']], headInline: 6.4, lineTop: 0.45, lineGap: 0.45,
    rowSw: 15.2, specGap: 0.6, tested: false, ciTop: 2.8, ciH: 1.6, ciGap: 0.5, ciLbl: 3.3, ciPadR: 2.5, pillInGap: false,
  },
];

const e = (v: number) => `${Math.round(v * 1000) / 1000}em`;
const u = (v: number) => `calc(var(--u) * ${Math.round(v * 1000) / 1000})`;
const at = (b: Box) => `left:${e(b.x)};top:${e(b.y)};width:${e(b.w)};height:${e(b.h)}`;
const keys: Key[] = ['select', 'button', 'search', 'badge', 'row'];

function layoutCss(s: Spec) {
  const win: Box = { x: s.m, y: s.m, w: s.W - 2 * s.m, h: s.H - 2 * s.m - s.gap - s.trayH };
  const tray: Box = { x: s.m, y: win.y + win.h + s.gap, w: win.w, h: s.trayH };
  const card: Box = { x: win.x + s.rail + s.pad, y: win.y + s.bar + s.pad, w: win.w - s.rail - 2 * s.pad, h: win.h - s.bar - 2 * s.pad };
  const ix = card.x + s.cardPad;
  const iw = card.w - 2 * s.cardPad;

  // The list card: header controls, then the table.
  const slot = {} as Record<Key, Box>;
  let y = card.y + s.hpad;
  let x = ix;
  const title: Box = { x, y, w: 6.6, h: s.ch };
  if (s.title) x += 6.6 + 0.8;
  slot.select = { x, y, w: SEL_W, h: s.ch };
  x += SEL_W + 0.8;
  slot.button = { x: ix + iw - BTN_W, y, w: BTN_W, h: s.ch };
  if (!s.oneLine) {
    y += s.ch + s.vgap;
    x = ix;
  }
  slot.search = { x, y, w: s.searchW, h: s.ch };
  const filter: Box = { x: x + s.searchW + 0.45, y, w: s.ch, h: s.ch };
  y += s.ch + s.tgap;
  const thead: Box = { x: card.x, y, w: card.w, h: 1.5 };
  if (s.thead) y += 1.5;
  const rows: Box[] = residents.map((_, i) => ({ x: card.x, y: y + i * s.rowH, w: card.w, h: s.rowH }));
  slot.row = rows[0];
  slot.badge = { x: card.x + card.w - s.cardPad - BADGE_W, y: rows[0].y + (s.rowH - BADGE_H) / 2, w: BADGE_W, h: BADGE_H };

  // The component sheet in the tray, line by line.
  const size: Record<Key, [number, number]> = {
    select: [SEL_W, s.ch], button: [BTN_W, s.ch], badge: [BADGE_W, BADGE_H], search: [SEARCH_SW, s.ch], row: [s.rowSw, s.rowH],
  };
  const spec = {} as Record<Key, Box>;
  const capShift = {} as Record<Key, number>;
  const lineH = (line: Key[]) => Math.max(...line.map((k) => size[k][1]));
  let sy = tray.y + s.lineTop + (s.captions ? 1.4 : 0);
  s.lines.forEach((line, i) => {
    const lh = lineH(line);
    let sx = tray.x + s.trayPad + (i === 0 ? s.headInline : 0);
    for (const k of line) {
      const [w, h] = size[k];
      spec[k] = { x: sx, y: sy + (lh - h) / 2, w, h };
      capShift[k] = (lh - h) / 2;
      sx += w + s.specGap;
    }
    sy += lh + s.lineGap + (s.captions ? 1.4 : 0);
  });
  const headH = s.headInline ? lineH(s.lines[0]) : 1.6;
  const head: Box = { x: tray.x + s.trayPad, y: tray.y + (s.headInline ? s.lineTop : 0.55), w: tray.w - 2 * s.trayPad, h: headH };
  const ci: Box = { x: tray.x + s.trayPad, y: tray.y + s.ciTop, w: tray.w - 2 * s.trayPad, h: 2 * s.ciH + s.ciGap };

  const P = '.demo-pcc';
  const vars = [
    `--u:min(calc(100cqw / ${s.W}), calc(100cqh / ${s.H}))`, `--ks:${s.ks}`, `--kt:${s.kt}`, `--pc-bar:${e(s.bar)}`,
    `--pc-rail:${e(s.rail)}`, `--cpad:${u(s.cardPad)}`, `--col-room:${u(s.room)}`, `--col-task:${u(s.task)}`,
    `--ci-h:${e(s.ciH)}`, `--ci-gap:${e(s.ciGap)}`, `--ci-lbl:${e(s.ciLbl)}`, `--ci-pad:${e(s.ciPadR)}`,
    `--rail-labels:${s.railLabels ? 'block' : 'none'}`, `--caps:${s.captions ? 'block' : 'none'}`,
    `--tested:${s.tested ? 'flex' : 'none'}`, `--gain-gap:${s.pillInGap ? 'flex' : 'none'}`,
    `--gain-head:${s.pillInGap ? 'none' : 'inline-flex'}`, `--after-labels:${s.afterLabels ? 1 : 0}`,
  ];
  const r = [
    `${P}{${vars.join(';')}}`,
    `${P} .pc-stage{width:${e(s.W)};height:${e(s.H)}}`,
    `${P} .pc-win{${at(win)}}`,
    `${P} .pc-tray{${at(tray)}}`,
    `${P} .pc-card{${at(card)}}`,
    `${P} .pc-title{${at(title)};display:${s.title ? 'flex' : 'none'}}`,
    `${P} .pc-filter{${at(filter)}}`,
    `${P} .pc-thead{${at(thead)};display:${s.thead ? 'block' : 'none'}}`,
    `${P} .pc-c-rm{display:${s.room ? 'block' : 'none'}}`,
    `${P} .pc-c-tk{display:${s.task ? 'block' : 'none'}}`,
    `${P} .pc-th{${at(head)}}`,
    `${P} .pc-ci{${at(ci)}}`,
  ];
  for (const k of keys) {
    const a = slot[k];
    const b = spec[k];
    r.push(`${P} .pc-p-${k}{${at(a)};--dx:${e(b.x - a.x)};--dy:${e(b.y - a.y)};--sw:${e(b.w)}}`, `${P} .pc-sp-${k}{${at(b)};--cs:${e(capShift[k])}}`);
    if (k !== 'badge' && k !== 'row') r.push(`${P} .pc-s-${k}{${at(a)}}`);
  }
  rows.forEach((b, i) => {
    const show = i < s.nRows;
    if (i > 0) r.push(`${P} .pc-c-row${i}{${at(b)};--cy:${e(-i * s.rowH)};display:${show ? 'block' : 'none'}}`);
    r.push(`${P} .pc-s-row${i}{${at({ x: b.x + 0.45, y: b.y + 0.22, w: b.w - 0.9, h: b.h - 0.44 })};display:${show ? 'block' : 'none'}}`);
  });
  const css = r.join('');
  return s.query ? `@container ${s.query}{${css}}` : css;
}

const layoutStyles = specs.map(layoutCss).join('\n');

const icon = {
  chev: "M3.5 6l4.5 4.5L12.5 6",
  people: "M7 9.2a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8Zm6.6.4a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6ZM1.5 16.2c.4-3 2.6-4.9 5.5-4.9s5.1 1.9 5.5 4.9Zm12.3 0c-.2-1.7-.8-3.1-1.8-4.1.6-.3 1.2-.4 1.8-.4 2.3 0 3.9 1.7 4.2 4.5Z",
  clip: "M7 2.5h6v2H7zM5 3.5h1.2v2.2h7.6V3.5H15c.8 0 1.5.7 1.5 1.5v11.5c0 .8-.7 1.5-1.5 1.5H5c-.8 0-1.5-.7-1.5-1.5V5c0-.8.7-1.5 1.5-1.5Zm2 6v1.6h6V9.5Zm0 3.4v1.6h4.2v-1.6Z",
  chart: "M3 16.5h14v1.5H3zM4.5 10h2.6v5.2H4.5zm4.2-5h2.6v10.2H8.7zm4.2 3h2.6v7.2h-2.6z",
  gear: "M10 6.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Zm7 4.6v-2.4l-2-.4a5 5 0 0 0-.6-1.4l1.1-1.7-1.7-1.7-1.7 1.1a5 5 0 0 0-1.4-.6l-.4-2H7.9l-.4 2a5 5 0 0 0-1.4.6L4.4 3.6 2.7 5.3l1.1 1.7a5 5 0 0 0-.6 1.4l-2 .4v2.4l2 .4c.1.5.3 1 .6 1.4l-1.1 1.7 1.7 1.7 1.7-1.1c.4.3.9.5 1.4.6l.4 2h2.4l.4-2c.5-.1 1-.3 1.4-.6l1.7 1.1 1.7-1.7-1.1-1.7c.3-.4.5-.9.6-1.4Z",
};
---

<div
  class="demo demo-pcc"
  data-seq
  data-cycle={T.cycle}
  role="img"
  aria-label="Illustration in the style of PointClickCare's provider portal. Parts from a shared UI library, a unit select, a New note button, a search box, a resident row and a due today badge, fly out of a component sheet and snap into place to build a unit's resident list. Then a CI pipeline of install, lint, test, build and deploy runs before and after, and the after run finishes 30% sooner, labeled 30% faster CI."
>
  <style is:inline set:html={layoutStyles}></style>
  <span class="pc-halo" aria-hidden="true"></span>
  <div class="pc-stage" aria-hidden="true">
    <div class="pc-win">
      <div class="pc-bar">
        <span class="pc-mark"></span>
        <span class="pc-prod">Provider Portal</span>
        <span class="pc-bar-icons">
          <svg viewBox="0 0 20 20"><path d="M4 4h12a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 16 14H8l-3.5 3v-3H4a1.5 1.5 0 0 1-1.5-1.5v-7A1.5 1.5 0 0 1 4 4Z" /></svg>
          <svg viewBox="0 0 20 20"><path d="M10 1.8a8.2 8.2 0 1 0 0 16.4 8.2 8.2 0 0 0 0-16.4Zm0 3.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6Zm0 11.5a6.5 6.5 0 0 1-4.9-2.2c1-1.4 2.8-2.2 4.9-2.2s3.9.8 4.9 2.2a6.5 6.5 0 0 1-4.9 2.2Z" /></svg>
        </span>
      </div>
      <div class="pc-rail">
        <span class="pc-nav pc-on"><i><svg viewBox="0 0 20 20"><path d={icon.people} /></svg></i><b>Residents</b></span>
        <span class="pc-nav"><i><svg viewBox="0 0 20 20"><path d={icon.clip} /></svg></i><b>Orders</b></span>
        <span class="pc-nav"><i><svg viewBox="0 0 20 20"><path d={icon.chart} /></svg></i><b>Insights</b></span>
        <span class="pc-nav"><i><svg viewBox="0 0 20 20"><path d={icon.gear} /></svg></i><b>Settings</b></span>
      </div>
    </div>
    <div class="pc-card"></div>
    <div class="pc-title"><span>Residents</span></div>
    <div class="pc-filter"><svg viewBox="0 0 16 16"><path d="M2.5 4.5h11M4.5 8h7M6.5 11.5h3" /></svg></div>
    <div class="pc-thead">
      <div class="pc-cols"><span class="pc-c-av"></span><span class="pc-c-nm">Resident</span><span class="pc-c-rm">Room</span><span class="pc-c-tk">Next</span><span class="pc-c-st">Status</span></div>
    </div>

    <span class="pc-slot pc-s-select"></span>
    <div class="pc-part pc-p-select" data-step data-at={T.fly.select}>
      <div class="pc-pv"><div class="pc-ctl pc-select"><span class="pc-tx">Unit 2 West</span><svg viewBox="0 0 16 16"><path d={icon.chev} /></svg></div></div>
    </div>
    <span class="pc-slot pc-pill-slot pc-s-button"></span>
    <div class="pc-part pc-p-button" data-step data-at={T.fly.button}>
      <div class="pc-pv"><div class="pc-ctl pc-btn"><span class="pc-tx">New note</span></div></div>
    </div>
    <span class="pc-slot pc-s-search"></span>
    <div class="pc-part pc-p-search" data-step data-at={T.fly.search}>
      <div class="pc-pv"><div class="pc-ctl pc-search"><svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.6" /><path d="M10.4 10.4 14 14" /></svg><span class="pc-tx">Search name</span></div></div>
    </div>
    <span class="pc-slot pc-s-row0"></span>
    <div class="pc-part pc-p-row" data-step data-at={T.fly.row}>
      <div class="pc-pv">
        <div class="pc-row">
          <span class="pc-c-av"><i class="pc-av"><b>{residents[0].ini}</b></i></span>
          <span class="pc-c-nm">{residents[0].name}</span>
          <span class="pc-c-rm">{residents[0].room}</span>
          <span class="pc-c-tk">{residents[0].task}</span>
          <span class="pc-c-st"><i class="pc-ph"></i></span>
        </div>
      </div>
    </div>
    {residents.slice(1).map((r, j) => (
      <>
        <span class={`pc-slot pc-s-row${j + 1}`}></span>
        <div class={`pc-clone pc-c-row${j + 1}`} data-step data-at={T.clone + j * 130}>
          <div class="pc-row">
            <span class="pc-c-av"><i class="pc-av"><b>{r.ini}</b></i></span>
            <span class="pc-c-nm">{r.name}</span>
            <span class="pc-c-rm">{r.room}</span>
            <span class="pc-c-tk">{r.task}</span>
            <span class="pc-c-st"><span class={`pc-ctl pc-badge pc-${r.status}`}><span class="pc-tx">{statusText[r.status as keyof typeof statusText]}</span></span></span>
          </div>
        </div>
      </>
    ))}
    <div class="pc-part pc-p-badge" data-step data-at={T.fly.badge}>
      <div class="pc-pv"><span class="pc-ctl pc-badge pc-due"><span class="pc-tx">Due today</span></span></div>
    </div>

    <div class="pc-tray"></div>
    <div class="pc-th">
      <span class="pc-th-ci" data-step data-at={T.swap}><svg viewBox="0 0 20 20"><circle cx="4" cy="10" r="2.2" /><circle cx="16" cy="10" r="2.2" /><path d="M6.2 10h7.6" /></svg>CI pipeline</span>
      <span class="pc-th-lib"><svg viewBox="0 0 20 20"><rect x="3" y="3" width="6" height="6" rx="1.2" /><rect x="11" y="3" width="6" height="6" rx="1.2" /><rect x="3" y="11" width="6" height="6" rx="1.2" /><rect x="11" y="11" width="6" height="6" rx="3" /></svg>UI library</span>
      <span class="pc-th-r">
        <span class="pc-tested"><i class="pc-tick"></i>tested</span>
        <span class="pc-gain-head pc-pill" data-step data-at={T.gain}>30% faster CI</span>
      </span>
    </div>

    <div class="pc-spec pc-sp-select" data-step data-at={T.spec.select}>
      <span class="pc-cap">Select</span>
      <div class="pc-ctl pc-select"><span class="pc-tx">Unit 2 West</span><svg viewBox="0 0 16 16"><path d={icon.chev} /></svg></div>
    </div>
    <div class="pc-spec pc-sp-button" data-step data-at={T.spec.button}>
      <span class="pc-cap">Button</span>
      <div class="pc-ctl pc-btn"><span class="pc-tx">New note</span></div>
    </div>
    <div class="pc-spec pc-sp-search" data-step data-at={T.spec.search}>
      <span class="pc-cap">Search</span>
      <div class="pc-ctl pc-search"><svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.6" /><path d="M10.4 10.4 14 14" /></svg><span class="pc-tx">Search name</span></div>
    </div>
    <div class="pc-spec pc-sp-badge" data-step data-at={T.spec.badge}>
      <span class="pc-cap">Badge</span>
      <span class="pc-ctl pc-badge pc-due"><span class="pc-tx">Due today</span></span>
    </div>
    <div class="pc-spec pc-sp-row" data-step data-at={T.spec.row}>
      <span class="pc-cap">Table row</span>
      <div class="pc-row">
