---
// Illustrative: a shared component library and a CI pipeline getting 30% faster.
---

<div class="demo demo-pcc" data-seq data-cycle="12000" role="img" aria-label="Illustration: a shared UI component library assembling, and a CI pipeline shrinking from 100 percent to 70 percent of its original duration.">
  <div class="lib">
    <div class="lib-head">ui library</div>
    <div class="tiles">
      <div class="tile" data-step data-at="200"><span class="t-btn">Save</span><span class="cap">button</span></div>
      <div class="tile" data-step data-at="500"><span class="t-input">Resident name</span><span class="cap">input</span></div>
      <div class="tile" data-step data-at="800"><span class="t-select">Unit 3B ▾</span><span class="cap">select</span></div>
      <div class="tile" data-step data-at="1100"><span class="t-badge">due today</span><span class="cap">badge</span></div>
      <div class="tile wide" data-step data-at="1400">
        <span class="t-table"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class="cap">table</span>
      </div>
    </div>
  </div>
  <div class="ci">
    <div class="lib-head">ci pipeline</div>
    <div class="row" data-step data-at="2600">
      <span class="lbl">before</span>
      <span class="bar before"><i style="--w:18%"></i><i style="--w:14%"></i><i style="--w:30%"></i><i style="--w:22%"></i><i style="--w:16%"></i></span>
    </div>
    <div class="row" data-step data-at="4200">
      <span class="lbl">after</span>
      <span class="bar after"><i style="--w:12.6%"></i><i style="--w:9.8%"></i><i style="--w:21%"></i><i style="--w:15.4%"></i><i style="--w:11.2%"></i></span>
    </div>
    <div class="legend">install · lint · test · build · deploy</div>
    <div class="delta" data-step data-at="6200">30% faster</div>
  </div>
  <span class="illustration-tag">illustration</span>
</div>

<style>
  .demo-pcc {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4cqw;
    padding: 7cqh 5cqw;
    font-size: clamp(9px, 2.1cqw, 19px);
    color: var(--ink);
    background:
      radial-gradient(circle at 10% 90%, color-mix(in srgb, var(--highlight) 30%, transparent), transparent 45%),
      var(--bg-soft);
    overflow: hidden;
  }

  .lib-head {
    font-family: var(--font-mono);
    color: var(--accent-ink);
    margin-bottom: 0.7em;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6em;
  }

  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5em;
    min-height: 4.4em;
    padding: 0.7em;
    border-radius: 0.7em;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .tile.wide {
    grid-column: span 2;
  }

  .cap {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--muted);
  }

  .t-btn {
    align-self: flex-start;
    padding: 0.3em 0.9em;
    border-radius: 0.4em;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .t-input,
  .t-select {
    padding: 0.3em 0.6em;
    border-radius: 0.4em;
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .t-badge {
    align-self: flex-start;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--highlight) 45%, transparent);
    color: var(--ink);
  }

  .t-table {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 0.35em;
  }

  .t-table i {
    height: 0.55em;
    border-radius: 0.3em;
    background: var(--line);
  }

  .t-tabs {
    display: flex;
    gap: 0.9em;
  }

  .t-tabs b {
    font-weight: 600;
    border-bottom: 2px solid var(--accent);
  }

  .t-tabs em {
    font-style: normal;
    color: var(--muted);
  }

  .ci {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9em;
  }

  .row {
    display: grid;
    grid-template-columns: 3.6em 1fr;
    align-items: center;
    gap: 0.6em;
  }

  .lbl {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--muted);
  }

  .bar {
    display: flex;
    height: 1.4em;
    gap: 2px;
  }

  .bar i {
    width: 0;
    height: 100%;
    border-radius: 0.3em;
    background: color-mix(in srgb, var(--ink) 25%, transparent);
    transition: width 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .bar.after i {
    background: var(--accent);
  }

  .row.is-on .bar i {
    width: var(--w);
  }

  .legend {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--muted);
    padding-left: 4.4em;
  }

  .delta {
    align-self: flex-start;
    margin-left: 4.4em;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
  }
</style>
