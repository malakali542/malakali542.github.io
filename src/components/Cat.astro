    '..offfffsffsffffffffo...',
    '...offffffffffwwfooo....',
    '...offfffffffffwfffo....',
    '...offfffffffffooffo....',
    '...offoooffoffo.offo....',
    '...owwo.owwowwo.owwo....',
    '....oo...oo.oo...oo.....',
    '........................',
  ],
  walk2: [
    '........................',
    '..............o.....o...',
    '..oo.........ofo...ofo..',
    '.offo........opfooofpo..',
    'offfo........opfffffpo..',
    'offo.........offffffffo.',
    'offo........offeffefffo.',
    'offo...ooooooffeffefffo.',
    '.offooofsffsffffwpwfffo.',
    '.offffffsffsffffwwwffo..',
    '..offfffsffsffffffffo...',
    '...offffffffffwwfooo....',
    '...offfffffffffwfo......',
    '....oofffffffffffo......',
    '.....offfooooofffo......',
    '.....owwwo...owwwo......',
    '......ooo.....ooo.......',
    '........................',
  ],
  blink: [
    '........................',
    '..............o.....o...',
    '..oo.........ofo...ofo..',
    '.offo........opfooofpo..',
    'offfo........opfffffpo..',
    'offo.........offffffffo.',
