// A pixel cat that lives on the bottom bar. It walks, sits, hops, says something about the page, and curls up
// asleep if you stay on one page long enough. Clicking it wakes it up. The art is 24x18, drawn as one path per
// color per frame, and the palette follows the site theme.

// o outline, f fur, s stripe, w white, p pink, e eye.
const frames: Record<string, string[]> = {
  stand: [
    '........................',
    '..............o.....o...',
    '..oo.........ofo...ofo..',
    '.offo........opfooofpo..',
    'offfo........opfffffpo..',
    'offo.........offffffffo.',
    'offo........offeffefffo.',
    'offo...ooooooffeffefffo.',
    '.offooofsffsffffwpwfffo.',
    '.offffffsffsffffwwwffo..',
    '..offfffsffsffffffffo...',
    '...offffffffffwwfooo....',
    '...offfffffffffwffo.....',
    '....offffffffffoffo.....',
    '....offoffoooffoffo.....',
    '....owwowwo.owwowwo.....',
    '.....oo.oo...oo.oo......',
    '........................',
  ],
  walk1: [
    '........................',
    '..............o.....o...',
    '..oo.........ofo...ofo..',
    '.offo........opfooofpo..',
    'offfo........opfffffpo..',
