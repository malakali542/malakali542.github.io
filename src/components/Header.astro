---
const path = Astro.url.pathname;
const items = [
  { href: '/work/', label: 'work' },
  { href: '/writing/', label: 'writing' },
  { href: '/about/', label: 'about' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="container site-header">
  <a class="brand" href="/" aria-label="malak ali, home">malak ali</a>
  <nav class="nav" aria-label="primary">
    {items.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="toggle dark mode">
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"></path></g></svg>
    </button>
  </nav>
</header>
