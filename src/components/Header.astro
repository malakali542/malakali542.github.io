---
const path = Astro.url.pathname;
const items = [
  { href: '/work/', label: 'work' },
  { href: '/writing/', label: 'writing' },
  { href: '/ai/', label: 'ai' },
  { href: '/about/', label: 'about' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="container site-header">
  <a class="brand" href="/" aria-label="malak ali, home">malak ali</a>
  <nav class="nav" aria-label="primary">
    {items.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="dark mode" data-theme-toggle>
      <span class="ts-track" aria-hidden="true">
        <svg class="ts-icon ts-sun" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path></g></svg>
        <svg class="ts-icon ts-moon" viewBox="0 0 24 24"><path fill="currentColor" d="M20.5 13.1A8.5 8.5 0 1 1 10.9 3.5a6.6 6.6 0 0 0 9.6 9.6z"></path></svg>
        <span class="ts-knob"></span>
      </span>
      <span class="ts-label" aria-hidden="true"><span class="ts-l-light">light</span><span class="ts-l-dark">dark</span></span>
    </button>
  </nav>
</header>
