---
export interface Crumb {
  href: string;
  label: string;
  current?: string;
}

export interface TocItem {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  crumb?: Crumb;
  toc?: TocItem[];
}

const { crumb, toc = [] } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/';
// On the home page the first two items follow the scroll between the work and on-the-side sections.
const items = [
  { href: '/', label: 'work', current: home || path.startsWith('/work/'), spy: home ? 'work' : undefined },
  { href: '/#side', label: 'on the side', current: false, spy: home ? 'side' : undefined, railOnly: true },
  { href: '/writing/', label: 'writing', current: path.startsWith('/writing/') },
  { href: '/ai/', label: 'ai', current: path.startsWith('/ai/') },
  { href: '/about/', label: 'about', current: path.startsWith('/about/') },
];
const sections = toc.filter((item) => item.depth === 2 || item.depth === 3);
// The dot starts on the current item so the first paint is already right. The script below takes over after that.
const currentIndex = items.findIndex((item) => item.current);
const dotStyle = `--i: ${currentIndex}`;
---

<header class="rail">
  {crumb ? (
    <nav class="crumbs" aria-label="breadcrumb">
      <a href={crumb.href}><span aria-hidden="true">← </span>{crumb.label}</a>
      {crumb.current && (
        <>
          <span class="sep" aria-hidden="true">/</span>
          <span aria-current="page">{crumb.current}</span>
        </>
      )}
    </nav>
  ) : (
    <a class="brand" href="/">malak ali</a>
  )}
  {sections.length > 0 ? (
    <nav class="rail-nav toc" aria-label="on this page">
      <ul>
        <li class="d2"><a href="#overview" data-toc="overview">overview</a></li>
        {sections.map((item) => (
          <li class={`d${item.depth}`}><a href={`#${item.slug}`} data-toc={item.slug}>{item.text}</a></li>
        ))}
      </ul>
      <span class="rail-dot" aria-hidden="true"></span>
    </nav>
  ) : (
    <nav class="rail-nav" aria-label="primary">
      <ul>
        {items.map((item) => (
          <li><a href={item.href} aria-current={item.current ? 'page' : undefined} data-toc={item.spy}>{item.label}</a></li>
        ))}
      </ul>
      {currentIndex >= 0 && <span class="rail-dot" style={dotStyle} aria-hidden="true"></span>}
    </nav>
  )}
  <script is:inline>
    // One dot marks the current item. It is placed before the first paint, then glides whenever
    // aria-current moves (the scrollspy in Base sets it as you scroll).
    (() => {
      // Arriving on a link to a section (like /#side) jumps straight there. Smooth scrolling is for
      // clicks within a page, and here it would scroll the whole page past the dot on load.
      if (location.hash) {
        const root = document.documentElement;
        root.style.scrollBehavior = 'auto';
        addEventListener('load', () => requestAnimationFrame(() => root.style.removeProperty('scroll-behavior')), { once: true });
      }
      const nav = document.querySelector('.rail .rail-nav');
      const dot = nav && nav.querySelector('.rail-dot');
      if (!dot) return;
      let y = '';
      const place = (glide) => {
        const link = nav.querySelector('a[aria-current]');
        if (!link) return;
        const style = getComputedStyle(link);
        const line = parseFloat(style.lineHeight) || parseFloat(style.fontSize) * 1.45;
        const top = link.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
        const next = `${(top + parseFloat(style.paddingTop) + (line - dot.offsetHeight) / 2).toFixed(2)}px`;
        if (next === y) return;
        y = next;
        if (!glide) dot.style.transition = 'none';
        dot.style.setProperty('--y', y);
        if (!glide) {
          dot.getBoundingClientRect();
          dot.style.transition = '';
        }
      };
      // A link straight to a section, like /#side, starts the dot on that section.
      let id = location.hash.slice(1);
      try {
        id = decodeURIComponent(id);
      } catch {}
      const target = id && Array.from(nav.querySelectorAll('a[data-toc]')).find((link) => link.dataset.toc === id);
      if (target) {
        nav.querySelectorAll('a[aria-current]').forEach((link) => link.removeAttribute('aria-current'));
        target.setAttribute('aria-current', 'location');
      }
      place(false);
      new MutationObserver(() => place(true)).observe(nav, { subtree: true, attributeFilter: ['aria-current'] });
      new ResizeObserver(() => place(false)).observe(nav.querySelector('ul'));
    })();
  </script>
</header>

<header class="topbar" id="topbar">
  <nav aria-label="primary">
    {items.filter((item) => !item.railOnly).map((item) => (
      <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>

<button class="theme-toggle" type="button" data-theme-toggle aria-label="toggle dark mode">
  <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
  <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"></path></g></svg>
</button>

{crumb && (
  <nav class="crumbs crumbs-inline" aria-label="breadcrumb">
    <a href={crumb.href}><span aria-hidden="true">← </span>{crumb.label}</a>
    {crumb.current && (
      <>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{crumb.current}</span>
      </>
    )}
  </nav>
)}
