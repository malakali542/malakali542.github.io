---
interface Props {
  href: string;
  title: string;
  caption?: string;
}

const { href, title, caption } = Astro.props;
const src = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(href)}&show_text=false&width=734`;
---

<figure>
  <div class="video-wrap">
    <iframe src={src} title={title} loading="lazy" style="width:100%;height:100%;border:0" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" allowfullscreen></iframe>
  </div>
  <figcaption>
    {caption && <>{caption} · </>}<a href={href}>watch on facebook</a>
  </figcaption>
</figure>
