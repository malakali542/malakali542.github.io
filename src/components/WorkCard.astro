---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  headingLevel?: 'h3' | 'h2';
}

const { entry, headingLevel = 'h3' } = Astro.props;
const { title, short, org, period, role, summary, card, caseStudy, badge } = entry.data;
const href = `/work/${entry.id}/`;
const Heading = headingLevel;
---

<article class:list={['card', { 'card-static': !caseStudy }]} id={entry.id}>
  <div class="card-media">
    <Media media={card} label={`${short}: preview`} />
  </div>
  <div class="card-body">
    <Heading class="card-title">{caseStudy ? <a href={href}>{title}</a> : title}</Heading>
    <div class="card-meta">{org} · {period} · {role}</div>
    <p class="card-summary">{summary}</p>
    {(caseStudy || badge) && (
      <div class="card-foot">
        {caseStudy && <span class="card-cta" aria-hidden="true">read the case study →</span>}
        {badge && <span class="card-badge">{badge}</span>}
      </div>
    )}
  </div>
</article>
