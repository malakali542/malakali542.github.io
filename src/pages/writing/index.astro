---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="writing" description="Essays by Malak Ali on AI for science, agents, evaluation and Arabic language AI.">
  <section class="container case-head">
    <h1>writing</h1>
  </section>
  <section class="container section" style="padding-top:8px">
    <PostList posts={posts} />
  </section>
</Base>
