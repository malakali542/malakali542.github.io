---
import { readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import { Content as Readme } from '../../../research/arabic-dialects/README.md';

const root = 'public/research/arabic-dialects';
const walk = (dir: string): string[] =>
  readdirSync(dir).flatMap((name) => {
    const path = join(dir, name);
    return statSync(path).isDirectory() ? walk(path) : [path];
  });

let files: { href: string; name: string; kb: string }[] = [];
try {
  files = walk(root)
    .map((path) => ({
      href: '/' + path.replace(/^public\//, ''),
      name: path.replace(`${root}/`, ''),
      kb: (statSync(path).size / 1024).toFixed(1),
    }))
    .sort((a, b) => a.name.localeCompare(b.name));
} catch {
  files = [];
}
---

<Base title="arabic dialects benchmark" description="Code, prompts, raw model replies and scores behind Malak Ali's Arabic dialects benchmark.">
  <section class="container case-head">
    <a class="back" href="/writing/arabic-dialects-benchmark/">← back to the post</a>
    <p class="eyebrow">research · code and data</p>
    <h1>arabic dialects benchmark</h1>
    <p class="lede">
      Everything behind <a href="/writing/arabic-dialects-benchmark/">Ask in Egyptian, get answered in MSA</a>: the
      harness, the 56 dialect prompts, every raw model reply, and the scores.
    </p>
  </section>
  <section class="container two-col" style="padding-bottom:40px">
    <div class="prose readme">
      <Readme />
    </div>
    <aside>
      <div class="side-list">
        <h2>files</h2>
        <ul>
          {files.map((file) => (
            <li>
              <a href={file.href}>{file.name}</a>
              <span class="tag">{file.kb} kb</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </section>
</Base>

<style>
  .readme > :global(h1:first-child),
  .readme > :global(h1:first-child + p) {
    display: none;
  }

  .readme > :global(h2:first-of-type) {
    margin-top: 0.6em;
  }
</style>
