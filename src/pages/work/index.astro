---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { key: 'work', title: 'product & engineering', note: 'microsoft, uber, pointclickcare' },
  { key: 'building', title: 'built on the side', note: 'startups, tools & hackathons' },
];
---

<Base title="work" description="Case studies and side projects from Malak Ali: Quine at Microsoft Research, Recall and Copilot at Microsoft AI, UberX Share at Uber, PointClickCare, Suelo, Career Compass, Scout and Dots.">
  <section class="container case-head">
    <h1>work</h1>
    <p class="lede">
      Case studies from foundation models and evals at Microsoft Research, consumer AI on Windows, rider flows and map
      infrastructure at Uber, and healthcare software at PointClickCare, plus two startups, a tool newcomers to Ontario
      use every month, and a hackathon win.
    </p>
  </section>
  {groups.map((group) => (
    <section class="container section">
      <div class="section-head">
        <h2>{group.title}</h2>
        <span class="mono muted">{group.note}</span>
      </div>
      <div class="grid">
        {work.filter((entry) => entry.data.group === group.key).map((entry) => <WorkCard entry={entry} />)}
      </div>
    </section>
  ))}
</Base>
