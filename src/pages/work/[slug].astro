---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work'))
    .filter((entry) => entry.data.caseStudy)
    .sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: work[i - 1] ?? null, next: work[i + 1] ?? null },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'> | null;
  next: CollectionEntry<'work'> | null;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const hero = data.hero ?? data.card;
const facts = [{ label: 'role', value: data.role }, ...data.facts];
---

<Base title={data.short} description={data.summary} type="article" crumb={{ href: '/', label: 'work', current: data.short }} toc={headings}>
  <article>
    <header class="detail-head" id="overview">
      <p class="eyebrow">{data.org} · {data.period}{data.badge && ` · ${data.badge}`}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="case-hero">
      <div class="hero-frame">
        <Media media={hero} label={`${data.short}: video`} />
      </div>
      {hero.caption && <p class="caption">{hero.caption}</p>}
    </div>

    {data.metrics.length > 0 && (
      <div class="metrics">
        {data.metrics.map((metric) => (
          <div class="metric">
            <span class="value">{metric.value}</span>
            <span class="label">{metric.label}</span>
          </div>
        ))}
      </div>
    )}

    <div class="case-body">
      <div class="prose">
        <Content />
      </div>
      {data.links.length > 0 && (
        <aside class="case-links">
          <h2>links &amp; press</h2>
          <ul>
            {data.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <nav class="case-nav" aria-label="more case studies">
      {prev ? (
        <a href={`/work/${prev.id}/`}><span class="dir">← previous</span>{prev.data.short}</a>
      ) : <span></span>}
      {next ? (
        <a class="next" href={`/work/${next.id}/`}><span class="dir">next →</span>{next.data.short}</a>
      ) : <span></span>}
    </nav>
  </article>
</Base>
