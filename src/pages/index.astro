---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tiles from '../components/Tiles.astro';

const work = (await getCollection('work', (entry) => entry.data.group === 'work')).sort((a, b) => a.data.order - b.data.order);
// Side projects used to live on this page, so old links to them land on /side/ instead.
const moved = ['side', ...(await getCollection('work', (entry) => entry.data.group === 'building')).map((entry) => entry.id)];
const redirect = `(() => { let id = location.hash.slice(1); try { id = decodeURIComponent(id); } catch {} if (${JSON.stringify(moved)}.includes(id)) location.replace(id === 'side' ? '/side/' : '/side/#' + id); })();`;
---

<Base>
  <script is:inline slot="head" set:html={redirect} />
  <section class="intro">
    <h1 class="statement"><em>malak ali</em> is a <span class="keep">product + engineer hybrid</span> working on ai for science and collaboration.</h1>
    <dl class="now-then">
      <div>
        <dt>currently</dt>
        <dd>research product manager @ <a href="https://www.microsoft.com/en-us/research/people/malakali/">microsoft research</a> on <a href="/work/quine/">quine</a> and <a href="/work/multiplayer/">multiplayer ai</a>, in seattle</dd>
      </div>
      <div>
        <dt>previously</dt>
        <dd>product manager @ microsoft ai on <a href="/work/recall/">recall</a> and <a href="/work/copilot-diagnostics/">copilot</a>, product manager @ enlighted (acquired, siemens), software engineer @ <a href="/work/uber/">uber</a> and <a href="/work/pointclickcare/">pointclickcare</a>.</dd>
      </div>
    </dl>
  </section>

  <section class="home-section" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">work</h2>
      <span class="section-note">microsoft research, microsoft ai, uber, pointclickcare</span>
    </div>
    <Tiles entries={work} feature="quine" />
  </section>
</Base>
