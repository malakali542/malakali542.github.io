---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tiles from '../components/Tiles.astro';

const work = (await getCollection('work', (entry) => entry.data.group === 'work')).sort((a, b) => a.data.order - b.data.order);
// Side projects used to live on this page, so old links to them land on /side/ instead.
const moved = ['side', ...(await getCollection('work', (entry) => entry.data.group === 'building')).map((entry) => entry.id)];
const redirect = `(() => { let id = location.hash.slice(1); try { id = decodeURIComponent(id); } catch {} if (${JSON.stringify(moved)}.includes(id)) location.replace(id === 'side' ? '/side/' : '/side/#' + id); })();`;
---

<Base>
  <script is:inline slot="head" set:html={redirect} />
  <script is:inline slot="head">
    try {
      if (!sessionStorage.getItem('intro') && matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('intro');
    } catch {}
  </script>
  <section class="intro">
    <h1 class="statement"><em>malak ali</em> is a <span class="keep">product + engineer hybrid</span> working on ai for science and collaboration.</h1>
    <dl class="now-then">
      <div>
        <dt>currently</dt>
        <dd>research product manager @ <a href="https://www.microsoft.com/en-us/research/people/malakali/">microsoft research</a> on <a href="/work/quine/">quine</a> and <a href="/work/multiplayer/">multiplayer ai</a>, in seattle</dd>
      </div>
      <div>
        <dt>previously</dt>
        <dd>product manager @ microsoft ai on <a href="/work/recall/">recall</a> and <a href="/work/copilot-diagnostics/">copilot</a>, product manager @ enlighted (acquired, siemens), software engineer @ <a href="/work/uber/">uber</a> and <a href="/work/pointclickcare/">pointclickcare</a>.</dd>
      </div>
    </dl>
  </section>

  <section class="home-section" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">work</h2>
      <span class="section-note">microsoft research, microsoft ai, uber, pointclickcare</span>
    </div>
    <Tiles entries={work} feature="quine" />
  </section>

  <script>
    // The first time someone opens the home page in a session, the statement arrives word by word and the
    // lines under it follow. The head script above hides both until the words are ready.
    const root = document.documentElement;
    const statement = document.querySelector<HTMLElement>('.statement');
    if (statement && root.classList.contains('intro')) {
      let count = 0;
      const split = (node: Node) => {
        for (const child of Array.from(node.childNodes)) {
          if (child.nodeType === Node.ELEMENT_NODE) {
            split(child);
            continue;
          }
          if (child.nodeType !== Node.TEXT_NODE) continue;
          const words = document.createDocumentFragment();
          for (const part of (child.textContent ?? '').split(/(\s+)/)) {
            if (!part) continue;
            if (!part.trim()) {
              words.append(part);
              continue;
            }
            const word = document.createElement('span');
            word.className = 'w';
            word.style.setProperty('--w', String(count++));
            word.textContent = part;
            words.append(word);
          }
          child.replaceWith(words);
        }
      };
      split(statement);
      try {
        sessionStorage.setItem('intro', '1');
      } catch {}
      const start = () => {
        root.classList.replace('intro', 'intro-go');
        // Afterwards the words go back to plain text, so the statement renders exactly as it does on later visits.
        window.setTimeout(() => {
          root.classList.remove('intro-go');
          statement.querySelectorAll('.w').forEach((word) => word.replaceWith(word.textContent ?? ''));
          statement.normalize();
        }, 2800);
      };
      Promise.race([document.fonts.ready, new Promise((resolve) => window.setTimeout(resolve, 600))]).then(() => requestAnimationFrame(start));
    }
  </script>
</Base>
