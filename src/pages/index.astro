---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkTile from '../components/WorkTile.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

// Mixed tile shapes stagger the two columns. Illustrations get 4:3 so they never squeeze.
const ratios: Record<string, string> = {
  quine: '4 / 3',
  'copilot-diagnostics': '4 / 3',
  'copilot-trusted-answers': '4 / 3',
  pointclickcare: '4 / 3',
  scout: '4 / 3',
  dots: '1 / 1',
};
const columns = [0, 1].map((side) => work.map((entry, index) => ({ entry, index })).filter(({ index }) => index % 2 === side));
---

<Base>
  <section class="intro">
    <h1 class="statement"><em>malak ali</em> is a <span class="keep">product + engineer</span> hybrid working on ai for science.</h1>
    <dl class="now-then">
      <div>
        <dt>currently</dt>
        <dd>research product manager @ <a href="https://www.microsoft.com/en-us/research/people/malakali/">microsoft research</a> on <a href="/work/quine/">quine</a>, in seattle</dd>
      </div>
      <div>
        <dt>previously</dt>
        <dd>product manager @ microsoft ai on <a href="/work/recall/">recall</a> and <a href="/work/copilot-diagnostics/">copilot</a>, product manager @ enlighted (acquired, siemens), software engineer @ <a href="/work/uber/">uber</a> and <a href="/work/pointclickcare/">pointclickcare</a>.</dd>
      </div>
    </dl>
  </section>

  <section class="tiles" aria-label="work">
    {columns.map((column) => (
      <div class="tiles-col">
        {column.map(({ entry, index }) => <WorkTile entry={entry} index={index} ratio={ratios[entry.id]} />)}
      </div>
    ))}
  </section>
</Base>
