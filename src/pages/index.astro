---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import PostList from '../components/PostList.astro';
import Media from '../components/Media.astro';
import { site } from '../lib/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const byGroup = (group: string) => work.filter((entry) => entry.data.group === group);
const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type SideItem = { name: string; href: string; tag: string; sub?: { label: string; href: string } };

const lists: { title: string; items: SideItem[] }[] = [
  {
    title: 'now',
    items: [
      {
        name: 'microsoft research',
        href: '/work/quine/',
        tag: 'research pm · quine',
        sub: { label: 'researcher profile', href: 'https://www.microsoft.com/en-us/research/people/malakali/' },
      },
    ],
  },
  {
    title: 'before',
    items: [
      { name: 'microsoft ai', href: '/work/recall/', tag: 'pm · recall, copilot' },
      { name: 'enlighted (acquired, siemens)', href: '/about/#experience', tag: 'pm' },
      { name: 'uber', href: '/work/uber/', tag: 'swe · uberx share' },
      { name: 'pointclickcare', href: '/work/pointclickcare/', tag: 'swe · provider portal' },
    ],
  },
  {
    title: 'on the side',
    items: [
      { name: 'suelo', href: '#suelo', tag: 'co-founder' },
      { name: 'career compass', href: '#career-compass', tag: '~400 monthly users' },
      { name: 'scout', href: '#scout', tag: 'co-founder' },
      { name: 'dots', href: '/work/dots/', tag: 'hackathon winner' },
    ],
  },
  {
    title: 'community',
    items: [
      { name: 'bridgeto youth × amazon', href: '/about/#community', tag: 'tech director' },
    ],
  },
];
---

<Base>
  <section class="container hero">
    <div>
      <h1>hi, i'm <em>malak</em>.</h1>
      <p class="tagline">product + engineer hybrid · uwaterloo alum · seattle</p>
      <p>i'm a research product manager at microsoft research, where i work on <a href="/work/quine/">quine</a>, a world model of biology and the agent harness that lets scientists use it. i decide what the model should learn next, lead the evals that tell us whether it did, and turn those results into a roadmap across mid-training and post-training.</p>
      <p>before that i was a product manager in microsoft ai, shipping <a href="/work/recall/">recall</a> and <a href="/work/copilot-diagnostics/">copilot</a> features to millions of windows pcs. before that i wrote code at <a href="/work/uber/">uber</a> and <a href="/work/pointclickcare/">pointclickcare</a>, and studied systems design engineering at the university of waterloo.</p>
      <p>outside of work i run coding hackathons for toronto kids with <a href="/about/#community">bridgeto and amazon</a>, build my own software with <a href="/ai/">frontier models, local models and agent swarms</a>, and <a href="/writing/">write</a> about ai for science, agents, evals and how well language models speak arabic.</p>
      <div class="links">
        {site.links.map((link) => <a href={link.href}>{link.label} ↗</a>)}
      </div>
    </div>
    <aside class="side-lists" aria-label="experience at a glance">
      {lists.map((list) => (
        <div class="side-list">
          <h2>{list.title}</h2>
          <ul>
            {list.items.map((item) => (
              <li class:list={[{ 'has-sub': item.sub }]}>
                <a href={item.href}>{item.name}</a>
                <span class="tag">[{item.tag}]</span>
                {item.sub && <a class="side-sub" href={item.sub.href}>{item.sub.label} ↗</a>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>
  </section>

  <section class="container section" id="work">
    <div class="section-head">
      <h2>selected work</h2>
      <span class="mono"><a href="/work/">all work →</a></span>
    </div>
    <div class="grid">
      {byGroup('work').map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>

  <section class="container section" id="building">
    <div class="section-head">
      <h2>built on the side</h2>
      <span class="mono muted">startups, tools &amp; hackathons</span>
    </div>
    <div class="grid">
      {byGroup('building').map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>

  <section class="container section" id="ai">
    <div class="section-head">
      <h2>how i use ai</h2>
      <span class="mono"><a href="/ai/">my stack →</a></span>
    </div>
    <article class="card ai-card">
      <div class="card-media">
        <Media media={{ kind: 'demo', name: 'ai-stack' }} label="My AI stack" />
      </div>
      <div class="card-body">
        <h3 class="card-title"><a href="/ai/">the models, agents and skills i build with</a></h3>
        <div class="card-meta">claude · gpt · qwen · gemma · phi · orca · capy · hermes</div>
        <p class="card-summary">
          I route work between frontier models and local ones, run swarms of coding agents on my own orchestrator built on
          Orca, and use Capy and Hermes for recursive self-improvement. With skills I wrote on top, I've replaced about half
          of my consumer subscriptions, from my own news digest and investing desk to budgeting apps and our family's
          daily games.
        </p>
        <span class="card-cta" aria-hidden="true">see how it fits together →</span>
      </div>
    </article>
  </section>

  <section class="container section" id="writing">
    <div class="section-head">
      <h2>writing</h2>
      <span class="mono"><a href="/writing/">all writing →</a></span>
    </div>
    <PostList posts={posts.slice(0, 5)} />
  </section>
</Base>
